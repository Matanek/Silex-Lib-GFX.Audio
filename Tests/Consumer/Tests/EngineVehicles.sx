use GFX.Audio.Synthesis
use GFX.Audio.Synthesis.EngineParts
use GFX.Audio.Synthesis.EngineVehicles
use GFX.Audio.Processing
use STD.Math

func zeros(count:int) float32[] {
    var result:float32[] = []; for _ in 0...count { result.append(0.0) }
    return result
}
func sound(parts:EngineParts.Assembly, rpm:float32 = 3_000.0, load:float32 = 0.7) float32[] {
    var source = Synthesis.Engine.assemble(parts, Processing.Format(sample_rate:48_000, channels:1))
    source.set_state(rpm, throttle:0.7, load:load, boost:0.7, ramp_frames:0)
    source.set_character(1.0, 0.0, ramp_frames:0)
    var samples = zeros(48_000); source.render(&samples[0:samples.count()])
    return samples
}
func residual(a:@float32[..], b:@float32[..]) float64 {
    var aa:float64 = 0.0; var bb:float64 = 0.0; var ab:float64 = 0.0
    for i in 12_000...a.count() {
        aa += a[i] as float64 * a[i] as float64; bb += b[i] as float64 * b[i] as float64
        ab += a[i] as float64 * b[i] as float64
    }
    assert(aa > 0.00001 && bb > 0.00001)
    return 1.0 - ab * ab / (aa * bb)
}

test "vehicle catalogue covers capacities cycles diesel and uneven firing without sound assets" {
    let profiles = EngineVehicles.catalogue()
    assert(profiles.count() == 17)
    for i, profile in profiles.indexed() {
        profile.parts.validate()
        assert(profile.idle_rpm > 0.0 && profile.redline_rpm > profile.idle_rpm && profile.redline_rpm <= 20_000.0)
        assert(profile.response_seconds >= 0.08 && profile.response_seconds <= 1.5)
        for j in 0...i { assert(profile.id != profiles[j].id) }
        let output = sound(profile.parts, profile.redline_rpm)
        var energy:float64 = 0.0
        for sample in output {
            assert(Math.is_finite(sample) && Math.abs(sample) <= 0.4)
            energy += sample as float64 * sample as float64
        }
        assert(energy > 0.01, "silent vehicle profile")
    }
    for i in 0...3 {
        let cc = [125.0, 250.0, 500.0][i]
        assert(Math.abs(profiles[8 + i].parts.block.displacement_litres() * 1_000.0 - cc) < 0.01)
        assert(profiles[8 + i].parts.block.cycle == EngineParts.Cycle.two_stroke)
    }
    assert(profiles[11].parts.block.cycle == EngineParts.Cycle.four_stroke)
    assert(Math.abs(profiles[12].parts.block.displacement_litres() - 0.5) < 0.0001)
    assert(profiles[2].parts.head.ignition == EngineParts.Ignition.compression)
    assert(profiles[15].parts.block.firing_angles[1] == 315.0 as float32)
    assert(profiles[7].parts.block.displacement_litres() > 5.9)
}

test "vehicle acoustic controls change waveform shape beyond a gain adjustment" {
    let profiles = EngineVehicles.catalogue()
    for control in 0...6 {
        var base = profiles[9].parts
        var mix = EngineParts.Mix(exhaust:1.0, intake:0.0, mechanics:0.0, turbo:0.0)
        if control >= 3 { mix = EngineParts.Mix(exhaust:0.0, intake:0.0, mechanics:1.0, turbo:0.0) }
        base.mix = mix
        var changed = base
        if control == 0 { base.head.sharpness = 0.0; changed.head.sharpness = 1.0 }
        if control == 1 { base.exhausts[0].silencer.baffles = 0; changed.exhausts[0].silencer.baffles = 6 }
        if control == 2 { base.exhausts[0].expansion_litres = 0.0; changed.exhausts[0].expansion_litres = 4.0 }
        if control == 3 { base.mechanics.clatter = 0.0; changed.mechanics.clatter = 1.0 }
        if control == 4 { base.mechanics.whine = 0.0; changed.mechanics.whine = 1.0 }
        if control == 5 { changed.head.ignition = EngineParts.Ignition.compression }
        let a = sound(base); let b = sound(changed)
        let difference = residual(@a[0:a.count()], @b[0:b.count()])
        print("vehicle control ", control, " gain-independent residual ", difference)
        assert(difference > 0.02, "control made only a small numerical or gain change")
    }
    let petrol = sound(profiles[1].parts, 1_000.0)
    let diesel = sound(profiles[2].parts, 1_000.0)
    assert(residual(@petrol[0:petrol.count()], @diesel[0:diesel.count()]) > 0.2)
    var twin = profiles[15].parts
    let uneven = sound(twin, 900.0)
    twin.block.firing_angles = []
    let even = sound(twin, 900.0)
    assert(residual(@uneven[0:uneven.count()], @even[0:even.count()]) > 0.2)
    for pair in [8, 9, 11, 13] {
        let a = sound(profiles[pair].parts, 6_000.0)
        let b = sound(profiles[pair + 1].parts, 6_000.0)
        assert(residual(@a[0:a.count()], @b[0:b.count()]) > 0.02, "vehicle variants differ only in level")
    }
}

test "vehicle definitions reject invalid acoustic settings before mutating a live engine" {
    let original = EngineVehicles.catalogue()[2].parts
    var source = Synthesis.Engine.assemble(original)
    for control in 0...6 {
        var parts = original
        if control == 0 { parts.head.sharpness = Math.sqrt(-1.0) }
        if control == 1 { parts.exhausts[0].silencer.baffles = 9 }
        if control == 2 { parts.exhausts[0].expansion_litres = -1.0 }
        if control == 3 { parts.mechanics.clatter = 1.1 }
        if control == 4 { parts.mechanics.whine = Math.sqrt(-1.0) }
        if control == 5 { parts.exhausts[0].silencer.baffles = -1 }
        match try source.set_parts(parts) { failure(error) => {}; success => { panic("invalid acoustic setting accepted") } }
        assert(source.parts()!.head.sharpness == original.head.sharpness)
    }
}

test "vehicle acoustics preserve split rendering reset and silence after rotation stops" {
    let parts = EngineVehicles.catalogue()[2].parts
    var a = Synthesis.Engine.assemble(parts); var b = Synthesis.Engine.assemble(parts)
    a.set_state(4_500.0, throttle:0.9, load:0.8, boost:0.7)
    b.set_state(4_500.0, throttle:0.9, load:0.8, boost:0.7)
    var expected = zeros(24_000); var actual = zeros(24_000)
    a.render(&expected[0:24_000])
    var offset = 0
    for end in [2, 68, 960, 1_002, 8_000, 24_000] { b.render(&actual[offset:end]); offset = end }
    for i in 0...24_000 { assert(expected[i] == actual[i]) }
    a.reset(); b.reset(); a.render(&expected[0:24_000]); b.render(&actual[0:24_000])
    for i in 0...24_000 { assert(expected[i] == actual[i]) }
    a.set_state(0.0, fuel:0.0, ramp_frames:0)
    for _ in 0...20 { a.render(&actual[0:24_000]) }
    for sample in actual { assert(Math.abs(sample) < 0.00001) }
}
