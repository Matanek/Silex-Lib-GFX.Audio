use GFX.Audio.Processing
use GFX.Audio.Synthesis
use STD.Error
use STD.Error.Kind
use STD.Math

func require(result:Result<void, Error>) { match result { failure(error) => { panic(error.detail) }; success => {} } }
func invalid(result:Result<void, Error>) { match result { failure(error) => { assert(error.kind == Kind.invalid_input() && error.operation == "audio.process") }; success => { panic("invalid accepted") } } }
func effect(channels:int = 1, decay:float32 = 1.5, damping:float32 = 0.0, wet:float32 = 1.0) Processing.Reverb {
    match (try Processing.Reverb.create(Processing.Format(sample_rate:48_000, channels:channels), room_size:1.0, decay_seconds:decay, damping:damping, wet:wet)) {
        failure(error) => { panic(error.detail) }; success(value) => { return value }
    }
}
func zeros(count:int) float32[] { var values:float32[] = []; var i = 0; while i < count { values.append(0.0); i++ } return values }
func impulse(count:int) float32[] { var values = zeros(count); values[0] = 1.0; return values }
func energy(values:@float32[..]) float64 { var sum:float64 = 0.0; for value in values { sum += value as float64 * value as float64 } return sum }
func roughness(values:@float32[..]) float64 {
    var sum:float64 = 0.0; var i = 1
    while i < values.count() { let difference = values[i] as float64 - values[i - 1] as float64; sum += difference * difference; i++ }
    return sum / energy(values)
}
func sequence(channels:int) float32[] {
    var values:float32[] = []; var i = 0
    while i < 12_007 * channels { values.append(((i * 17) % 31 - 15) as float32 / 128.0); i++ }
    return values
}
test "reverb first impulse echoes match causal comb and true allpass delays" {
    var reverb = effect()
    var values = impulse(4_300); require((try reverb.process(&values[0:values.count()])))
    var i = 0; while i < 2_858 { assert(values[i] == 0.0 as float32); i++ }
    assert(values[2_858] == 0.0625 as float32)
    assert(values[3_024] == -0.09375 as float32)
    assert(values[3_190] == -0.046875 as float32)
    assert(values[3_340] == -0.09375 as float32)
    assert(values[3_566] == 0.0625 as float32)
    assert(values[3_946] == 0.0625 as float32)
    assert(values[4_198] == 0.0625 as float32)
}
test "damped feedback second return follows independently computed decay and pole" {
    var reverb = effect(decay:0.75, damping:0.5)
    var values = impulse(5_720); require((try reverb.process(&values[0:values.count()])))
    let gain:float64 = Math.exp(-6.907755278982137 * 2_858.0 / (48_000.0 * 0.75))
    let first = 0.0625 * gain * (1.0 - 0.475)
    assert(Math.abs(values[5_716] as float64 - first) < 0.000001)
    assert(Math.abs(values[5_717] as float64 - first * 0.475) < 0.000001)
}
test "reverb preserves exact chunk and reset output on one two and eight channels" {
    for channels in [1, 2, 8] {
        var reverb = effect(channels, decay:0.8, damping:0.6, wet:0.4)
        var whole = sequence(channels); var split = sequence(channels)
        require((try reverb.process(&whole[0:whole.count()]))); reverb.reset()
        require((try reverb.process(&split[0:0]))); require((try reverb.process(&split[0:channels])))
        require((try reverb.process(&split[channels:2_857 * channels]))); require((try reverb.process(&split[2_857 * channels:6_013 * channels]))); require((try reverb.process(&split[6_013 * channels:split.count()])))
        var i = 0; while i < whole.count() { assert(whole[i] == split[i]); i++ }
    }
}
test "reverb histories stay independent with silent and identical stereo inputs" {
    var reverb = effect(channels:2)
    var values = impulse(14_000); require((try reverb.process(&values[0:values.count()])))
    var frame = 0; while frame < 7_000 { assert(values[frame * 2 + 1] == 0.0 as float32); frame++ }
    assert(values[2_858 * 2] == 0.0625 as float32)
    reverb.reset(); values = zeros(14_000); values[0] = 1.0; values[1] = 1.0
    require((try reverb.process(&values[0:values.count()])))
    frame = 0; while frame < 7_000 { assert(values[frame * 2] == values[frame * 2 + 1]); frame++ }
}
test "dry mix and bypass continue history and reveal the same delayed tail" {
    var reverb = effect(wet:0.0)
    var values = impulse(2_858); require((try reverb.process(&values[0:values.count()]))); assert(values[0] == 1.0 as float32)
    require((try reverb.set_wet(1.0))); values = zeros(1); require((try reverb.process(&values[0:1]))); assert(values[0] == 0.0625 as float32)
    reverb.reset(); reverb.set_bypass(true); values = impulse(2_858)
    require((try reverb.process(&values[0:values.count()]))); assert(values[0] == 1.0 as float32)
    reverb.set_bypass(false); values = zeros(1); require((try reverb.process(&values[0:1]))); assert(values[0] == 0.0625 as float32)
    reverb.reset(); require((try reverb.set_wet(0.5))); values = impulse(4_300); require((try reverb.process(&values[0:values.count()])))
    assert(values[0] == 0.5 as float32 && values[2_858] == 0.03125 as float32)
}
test "settings retain history while reset retains the chosen configuration" {
    var reverb = effect(decay:0.2)
    var values = impulse(2_858); require((try reverb.process(&values[0:values.count()])))
    require((try reverb.set_decay(0.8))); require((try reverb.set_damping(0.6))); require((try reverb.set_wet(0.4)))
    values = zeros(1); require((try reverb.process(&values[0:1]))); assert(values[0] == 0.025 as float32)
    reverb.reset(); var expected_effect = effect(decay:0.8, damping:0.6, wet:0.4)
    values = sequence(1); var expected = sequence(1)
    require((try reverb.process(&values[0:values.count()]))); require((try expected_effect.process(&expected[0:expected.count()])))
    var i = 0; while i < values.count() { assert(values[i] == expected[i]); i++ }
}
test "reverb rejects controls formats and whole blocks before state changes" {
    for rate in [0, 384_001] {
        match (try Processing.Reverb.create(Processing.Format(sample_rate:rate, channels:1))) { success(value) => { panic("rate accepted") }; failure(error) => { assert(error.kind == Kind.invalid_input()) } }
    }
    let format = Processing.Format(sample_rate:48_000, channels:2)
    match (try Processing.Reverb.create(format, room_size:1.01)) { success(value) => { panic("size accepted") }; failure(error) => {} }
    match (try Processing.Reverb.create(format, decay_seconds:0.04)) { success(value) => { panic("decay accepted") }; failure(error) => {} }
    match (try Processing.Reverb.create(format, damping:-0.01)) { success(value) => { panic("damping accepted") }; failure(error) => {} }
    match (try Processing.Reverb.create(format, wet:Math.sqrt(-1.0))) { success(value) => { panic("wet accepted") }; failure(error) => {} }
    var reverb = effect(channels:2)
    invalid((try reverb.set_decay(20.1))); invalid((try reverb.set_decay(Math.exp(1000.0))))
    invalid((try reverb.set_damping(-0.01))); invalid((try reverb.set_damping(Math.sqrt(-1.0)))); invalid((try reverb.set_wet(1.01)))
    var bad:float32[] = [1.0 as float32, 0.0 as float32, Math.sqrt(-1.0) as float32, 0.0 as float32]
    invalid((try reverb.process(&bad[0:4]))); assert(bad[0] == 1.0 as float32)
    var incomplete:float32[] = [1.0 as float32, 0.0 as float32, 0.0 as float32]
    invalid((try reverb.process(&incomplete[0:3]))); assert(incomplete[0] == 1.0 as float32)
    var values = impulse(6_000); require((try reverb.process(&values[0:values.count()]))); assert(values[2_858 * 2] == 0.0625 as float32)
}
test "feedback overflow preserves the failing frame and reset restores silence" {
    var reverb = effect(channels:2)
    var values:float32[] = []; var i = 0
    while i < 2_859 { values.append(0.25); values.append(3.402823466e38); i++ }
    match (try reverb.process(&values[0:values.count()])) { success => { panic("overflow accepted") }; failure(error) => { assert(error.kind == Kind.limit_exceeded() && error.operation == "audio.process") } }
    assert(values[0] == 0.0 as float32 && values[1] == 0.0 as float32)
    assert(values[2_858 * 2] == 0.25 as float32 && values[2_858 * 2 + 1] == 3.402823466e38 as float32)
    reverb.reset(); values = zeros(12_000); require((try reverb.process(&values[0:values.count()])))
    assert(energy(@values[0:values.count()]) == 0.0)
}
test "longer decay retains more late energy and shorter tails return to silence" {
    var short = effect(decay:0.2); var long = effect(decay:1.5)
    var a = impulse(144_000); var b = impulse(144_000)
    require((try short.process(&a[0:a.count()]))); require((try long.process(&b[0:b.count()])))
    assert(energy(@b[24_000:48_000]) > 100.0 * energy(@a[24_000:48_000]))
    assert(energy(@a[96_000:144_000]) < 0.000000000001)
    assert(energy(@b[96_000:144_000]) < energy(@b[24_000:48_000]))
    for value in b { assert(Math.is_finite(value) && Math.abs(value) < 1.0) }
}
test "damping reduces normalized high frequency variation in the late impulse tail" {
    var bright = effect(damping:0.0); var dark = effect(damping:1.0)
    var a = impulse(48_000); var b = impulse(48_000)
    require((try bright.process(&a[0:a.count()]))); require((try dark.process(&b[0:b.count()])))
    assert(roughness(@b[12_000:48_000]) < 0.5 * roughness(@a[12_000:48_000]))
}
class Pulse:Synthesis.Generator {
    let format:Processing.Format = Processing.Format(sample_rate:48_000, channels:1)
    private var first:bool = true
    func render(samples:&float32[..]) Result<void, Error> {
        var i = 0; while i < samples.count() { samples[i] = 0.0; if self.first { samples[i] = 1.0; self.first = false } i++ }
        return Result<void, Error>.success()
    }
    func reset() { self.first = true }
}
test "reverb prepares the maximum format and keeps minimum rate causal" {
    match (try Processing.Reverb.create(Processing.Format(sample_rate:384_000, channels:8), room_size:1.0, decay_seconds:20.0, damping:1.0, wet:1.0)) {
        failure(error) => { panic(error.detail) }
        success(var reverb) => { var values = impulse(16); require((try reverb.process(&values[0:16]))); assert(energy(@values[0:16]) == 0.0) }
    }
    match (try Processing.Reverb.create(Processing.Format(sample_rate:1, channels:1), room_size:0.0, decay_seconds:0.05, damping:0.0, wet:1.0)) {
        failure(error) => { panic(error.detail) }
        success(var reverb) => {
            var values = impulse(4); require((try reverb.process(&values[0:4])))
            assert(values[0] == 0.0 as float32 && values[1] == 0.25 as float32 && values[2] == -0.75 as float32 && values[3] == 0.1875 as float32)
        }
    }
}
class Double:Processing.Processor {
    let format:Processing.Format = Processing.Format(sample_rate:48_000, channels:1)
    func process(samples:&float32[..]) Result<void, Error> { var i = 0; while i < samples.count() { samples[i] *= 2.0; i++ } return Result<void, Error>.success() }
    func reset() {}
}
test "consumer source and custom processor compose with reverb across blocks" {
    let effects:Processing.Processor[] = [effect(), Double()]
    match (try Synthesis.Processed.create(Pulse(), effects)) {
        failure(error) => { panic(error.detail) }
        success(var source) => {
            var values = zeros(6_000); require((try source.render(&values[0:values.count()]))); assert(values[2_858] == 0.125 as float32)
            source.reset(); var split = zeros(6_000)
            require((try source.render(&split[0:2_857]))); require((try source.render(&split[2_857:split.count()])))
            var i = 0; while i < values.count() { assert(values[i] == split[i]); i++ }
        }
    }
}
