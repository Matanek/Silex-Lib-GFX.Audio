use GFX.Audio.Engines
use GFX.Audio.Engines.Vehicles
use STD.Math
use STD.System

func zeros() float32[] { var samples:float32[] = []; for _ in 0...960 { samples.append(0.0) }
    return samples }

test "vehicle reference preserves every Chevrolet PCM sample and operating state" {
    if System.target_name(System.target()) != "macos-arm64" { return }
    var library = Engines.Library.open()
    var original = library.engine("454")
    var vehicle = Vehicles.create("454")
    var a = zeros(); var b = zeros()
    var controls = Engines.Controls(running:true)
    assert(original.frame() == 0 && original.last_combustion_frame(0) == null)
    for phase in 0...3 {
        controls.accelerating = phase == 1
        if phase == 2 { controls.running = false }
        original.set_controls(controls); vehicle.set_controls(controls)
        for _ in 0...160 {
            original.render(&a[0:960]); vehicle.render(&b[0:960])
            assert(original.current_rpm() == vehicle.current_rpm())
            assert(original.frame() == vehicle.frame())
            for cylinder in 0...8 {
                assert(original.last_combustion_frame(cylinder) == vehicle.last_combustion_frame(cylinder))
            }
            for i in 0...960 { assert(a[i] == b[i], "vehicle factory changed the reference PCM") }
        }
    }
    assert(original.frame() == 3 * 160 * 480)
    for cylinder in 0...8 {
        let frame = original.last_combustion_frame(cylinder)!
        assert(frame > 0 && frame <= (2 * 160 + 1) * 480)
    }
    original.reset()
    assert(original.frame() == 0 && original.last_combustion_frame(0) == null)
}

test "native vehicle catalogue renders all architectures without the pulse synthesizer" {
    assert(Vehicles.catalogue().count() == 18)
    if System.target_name(System.target()) != "macos-arm64" {
        match try Vehicles.create() { failure(error) => {}; success(value) => { panic("unqualified native target accepted") } }
        return
    }
    for profile in Vehicles.catalogue() {
        var source = Vehicles.create(profile.key)
        var samples = zeros(); var controls = source.controls()
        controls.running = true; controls.accelerating = true
        source.set_controls(controls)
        var energy:float64 = 0.0
        for _ in 0...480 {
            source.render(&samples[0:960])
            for sample in samples { assert(Math.is_finite(sample) && Math.abs(sample) <= 1.0); energy += sample as float64 * sample as float64 }
        }
        print(profile.key, " rpm=", source.current_rpm(), " energy=", energy)
        assert(source.current_rpm() > 500.0 && energy > 0.001)
    }
}

test "vehicle geometry and analog throttle reject invalid requests" {
    match try Vehicles.create("missing") { failure(error) => {}; success(value) => { panic("unknown profile accepted") } }
    match try Vehicles.create("454", displacement_cc:Math.sqrt(-1.0)) { failure(error) => {}; success(value) => { panic("NaN capacity accepted") } }
    match try Vehicles.create("454", displacement_cc:5_000.0) { failure(error) => {}; success(value) => { panic("reference geometry changed") } }
    if System.target_name(System.target()) != "macos-arm64" { return }
    var source = Vehicles.create()
    var controls = source.controls(); controls.throttle = 1.01
    match try source.set_controls(controls) { failure(error) => {}; success => { panic("invalid throttle accepted") } }
    assert(source.controls().throttle == null)
}

test "analog throttle is continuous and vehicle displacement remains effective across reset" {
    if System.target_name(System.target()) != "macos-arm64" { return }
    var a = Vehicles.create(); var b = Vehicles.create()
    var low = a.controls(); low.running = true; low.throttle = 0.25
    var high = b.controls(); high.running = true; high.throttle = 0.8
    a.set_controls(low); b.set_controls(high)
    var samples = zeros()
    for _ in 0...320 { a.render(&samples[0:960]); b.render(&samples[0:960]) }
    assert(b.current_rpm() > a.current_rpm() + 100.0)
    var small = Vehicles.create("cross-250-4t", displacement_cc:300.0)
    var first = zeros(); var again = zeros()
    small.set_controls(Engines.Controls(running:true, throttle:0.4))
    for _ in 0...120 { small.render(&first[0:960]) }
    small.reset()
    for _ in 0...120 { small.render(&again[0:960]) }
    for i in 0...960 { assert(first[i] == again[i], "reset lost the configured engine or its commands") }
}

test "native V10 crank rebound at dyno release decodes as stopped" {
    if System.target_name(System.target()) != "macos-arm64" { return }
    var engine = Vehicles.create("sport-v10")
    var controls = engine.controls(); controls.running = true; controls.idle_rpm = 900.0
    var samples = zeros(); var stopped = false
    for block in 0...820 {
        let time = (block + 1) as float * 480.0 / 44_100.0
        controls.throttle = 0.0; controls.load = 0.1
        if time >= 2.0 && time < 4.0 { controls.throttle = (time - 2.0) / 2.0 }
        if time >= 4.0 && time < 6.0 { controls.throttle = 1.0; controls.load = 0.7 }
        engine.set_controls(controls); engine.render(&samples[0:960])
        assert(Math.is_finite(engine.current_rpm()) && engine.current_rpm() >= 0.0)
        if time > 6.0 && engine.current_rpm() == 0.0 { stopped = true }
    }
    assert(stopped, "test did not reach the native crank rebound")
}

test "vehicle bench transmission preserves neutral and couples the same running engine" {
    if System.target_name(System.target()) != "macos-arm64" { return }
    var free = Vehicles.create("454")
    var bench = Vehicles.create("454", transmission:Engines.Transmission.manual)
    var a = zeros(); var b = zeros()
    free.set_controls(Engines.Controls(running:true, throttle:0.7))
    var controls = bench.controls()
    controls.running = true; controls.throttle = 0.7
    bench.set_controls(controls)
    for _ in 0...200 {
        free.render(&a[0:960]); bench.render(&b[0:960])
        assert(bench.current_rpm() == free.current_rpm())
        assert(bench.drive_state()!.gear == 0)
        for i in 0...960 { assert(a[i] == b[i], "neutral changed the free-running sound") }
    }
    controls.gear = 1; bench.set_controls(controls)
    for _ in 0...260 { bench.render(&b[0:960]) }
    let first = bench.drive_state()!
    assert(first.gear == 1 && first.speed_kmh > 5.0)
    controls.gear = 2; bench.set_controls(controls)
    for _ in 0...200 { bench.render(&b[0:960]) }
    assert(bench.drive_state()!.gear == 2 && bench.drive_state()!.speed_kmh > first.speed_kmh)
    let before = bench.frame()
    controls.gear = 0; bench.set_controls(controls)
    for _ in 0...60 { bench.render(&b[0:960]) }
    assert(bench.drive_state()!.gear == 0 && bench.drive_state()!.speed_kmh > 0.0)
    assert(bench.frame() == before + 60 * 480)
    assert(bench.last_combustion_frame(0)! > before)
}

test "bench first gear keeps combustion and the 500 motocross reaches second promptly" {
    if System.target_name(System.target()) != "macos-arm64" { return }
    for key in ["sport-v12", "cross-500-4t"] {
        var engine = Vehicles.create(key, transmission:Engines.Transmission.manual)
        var input = engine.controls()
        var samples = zeros()
        input.running = true
        engine.set_controls(input)
        for _ in 0...200 { engine.render(&samples[0:960]) }
        input.gear = 1
        engine.set_controls(input)
        for _ in 0...32 { engine.render(&samples[0:960]) }
        assert(engine.drive_state()!.gear == 1 && engine.current_rpm() > 1_000.0)
        input.gear = 0; input.throttle = 0.26
        engine.set_controls(input)
        for _ in 0...55 { engine.render(&samples[0:960]) }
        let before = engine.frame()
        input.gear = 1
        engine.set_controls(input)
        for _ in 0...34 {
            engine.render(&samples[0:960])
            assert(engine.current_rpm() > 1_000.0, key + " · RPM collapsed on first gear engagement")
        }
        assert(engine.drive_state()!.gear == 1 && engine.last_combustion_frame(0)! > before)
        if key == "cross-500-4t" {
            assert(engine.gearing.final_drive == 8.5)
            input.throttle = 1.0
            engine.set_controls(input)
            for _ in 0...125 {
                if engine.drive_state()!.speed_kmh >= 25.0 { break }
                engine.render(&samples[0:960])
            }
            assert(engine.drive_state()!.speed_kmh >= 25.0)
            input.gear = 2
            engine.set_controls(input)
            for _ in 0...150 {
                if engine.drive_state()!.speed_kmh >= 45.0 { break }
                engine.render(&samples[0:960])
            }
            assert(engine.drive_state()!.gear == 2 && engine.drive_state()!.speed_kmh >= 45.0)
        }
    }
}

test "GTI pulls through its gears and back-drives the engine when downshifting" {
    if System.target_name(System.target()) != "macos-arm64" { return }
    var engine = Vehicles.create("sport-turbo-i4", transmission:Engines.Transmission.manual)
    assert(engine.gearing.ratios.count() == 6)
    var input = engine.controls()
    var samples = zeros()
    input.running = true
    engine.set_controls(input)
    for _ in 0...180 { engine.render(&samples[0:960]) }
    input.throttle = 1.0
    engine.set_controls(input)
    for gear in 1...5 {
        let before = engine.current_rpm()
        engine.request_gear(gear)
        for _ in 0...40 { engine.render(&samples[0:960]) }
        assert(engine.drive_state()!.gear == gear)
        if gear > 1 { assert(engine.current_rpm() < before * 0.93, "RPM must drop after upshifting") }
        for _ in 0...1_200 {
            if engine.current_rpm() >= engine.profile.redline * 0.92 { break }
            engine.render(&samples[0:960])
        }
        assert(engine.current_rpm() >= engine.profile.redline * 0.92)
    }
    engine.request_gear(5)
    for _ in 0...900 {
        if engine.drive_state()!.gear == 5 && engine.drive_state()!.speed_kmh >= 213.0 { break }
        engine.render(&samples[0:960])
    }
    assert(engine.drive_state()!.gear == 5 && engine.drive_state()!.speed_kmh >= 213.0)
    let speed = engine.drive_state()!.speed_kmh
    input = engine.controls()
    input.throttle = 0.0
    engine.set_controls(input)
    engine.request_gear(3)
    engine.render(&samples[0:960])
    assert(engine.drive_state()!.gear == 3 && !engine.drive_state()!.shift_refused)
    var peak_rpm = engine.current_rpm()
    for _ in 0...80 {
        engine.render(&samples[0:960])
        peak_rpm = Math.max(peak_rpm, engine.current_rpm())
        for sample in samples { assert(Math.is_finite(sample) && Math.abs(sample) <= 1.0) }
    }
    assert(peak_rpm > engine.profile.redline * 1.15)
    assert(engine.drive_state()!.speed_kmh < speed - 4.0)
}

test "GTI first gear responds to the 150 ms pedal from a stationary idle" {
    if System.target_name(System.target()) != "macos-arm64" { return }
    for warmup in [45, 230] {
        var engine = Vehicles.create("sport-turbo-i4", transmission:Engines.Transmission.manual)
        var input = engine.controls()
        var samples = zeros()
        input.running = true
        engine.set_controls(input)
        for _ in 0...warmup { engine.render(&samples[0:960]) }
        engine.request_gear(1)
        for _ in 0...28 { engine.render(&samples[0:960]) }
        input = engine.controls()
        let initial = engine.current_rpm()
        for block in 0...75 {
            input.throttle = Math.min(block as float * 480.0 / 6_615.0, 1.0)
            engine.set_controls(input)
            engine.render(&samples[0:960])
        }
        assert(engine.drive_state()!.gear == 1)
        assert(engine.current_rpm() > Math.max(2_200.0, initial + 300.0))
    }
}
