use GFX.Audio.Engines
use STD.Process
use STD.Error
use STD.Math
use STD.Time.Stopwatch

func main() {
    let arguments = Process.arguments()
    var directory = "Build/EngineLibrary-Package"
    if arguments.count() > 1 { directory = arguments[1] }
    var library = Engines.Library.open(directory)
    match try library.engine("missing") { failure(error) => {}; success(value) => { panic("unknown profile accepted") } }
    var synchronous = library.engine(); var asynchronous = library.engine()
    var expected:float32[] = []; var actual:float32[] = []
    for _ in 0...960 { expected.append(0.0); actual.append(0.0) }
    assert(!asynchronous.render_ready(&actual[0:960]))
    match try asynchronous.enqueue(5) { failure(error) => {}; success => { panic("unbounded queue accepted") } }
    match try asynchronous.render_ready(&actual[0:1]) { failure(error) => {}; success(value) => { panic("partial frame accepted") } }
    var control = synchronous.controls()
    var invalid = control; invalid.load = Math.sqrt(-1.0)
    match try synchronous.set_controls(invalid) { failure(error) => {}; success => { panic("NaN control accepted") } }
    assert(synchronous.controls().load == control.load)
    for batch in 0...100 {
        control.running = batch >= 2 && batch < 70
        control.accelerating = batch >= 30 && batch < 50
        synchronous.set_controls(control); asynchronous.set_controls(control)
        asynchronous.enqueue()
        assert(asynchronous.pending_blocks() == 4)
        match try asynchronous.render(&actual[0:960]) { failure(error) => {}; success => { panic("sync rendering raced a pending queue") } }
        for block in 0...4 {
            synchronous.render(&expected[0:960])
            var watch = Stopwatch(); watch.start()
            while !asynchronous.render_ready(&actual[0:960]) { assert(watch.get_elapsed_milliseconds() < 5_000.0, "renderer timed out") }
            assert(asynchronous.current_rpm() == synchronous.current_rpm())
            for i in 0...960 { assert(expected[i] == actual[i] && Math.is_finite(actual[i]), "asynchronous path changed PCM") }
        }
        assert(asynchronous.pending_blocks() == 0)
    }
    asynchronous.enqueue(); asynchronous.reset()
    assert(asynchronous.pending_blocks() == 0 && asynchronous.current_rpm() == 0.0)
    assert(asynchronous.controls().load == control.load)
    print("Engine library checks passed: controls, FIFO, bit-exact async PCM, reset and pending shutdown")
}
