use GFX.Audio.Engines
use STD.Process
use STD.Math

func rejected(library:Engines.Library, gearing:Engines.Gearing) {
    match try library.engine(transmission:Engines.Transmission.manual, gearing:gearing) {
        failure(error) => {}
        success(value) => { panic("invalid gearing accepted") }
    }
}
func stock_parity(library:Engines.Library) {
    for profile in library.profiles() {
        var original = library.engine(profile.key, transmission:Engines.Transmission.automatic)
        var explicit = library.engine(profile.key, transmission:Engines.Transmission.automatic, gearing:profile.gearing)
        var a:float32[] = []; var b:float32[] = []
        for _ in 0...960 { a.append(0.0); b.append(0.0) }
        var control = original.controls(); control.running = true; control.accelerating = true
        original.set_controls(control); explicit.set_controls(control)
        for _ in 0...180 {
            original.render(&a[0:960]); explicit.render(&b[0:960])
            assert(original.current_rpm() == explicit.current_rpm() && original.drive_state()!.speed_kmh == explicit.drive_state()!.speed_kmh)
            for i in 0...960 { assert(a[i] == b[i], "explicit stock gearing changed PCM") }
        }
        print("Explicit stock gearing is bit-exact: ", profile.key)
    }
}
func coupled(library:Engines.Library, configuration:Engines.Gearing) {
    var engine = library.engine(transmission:Engines.Transmission.manual, gearing:configuration)
    var control = engine.controls(); control.running = true; control.accelerating = true; control.gear = 1
    engine.set_controls(control)
    var samples:float32[] = []; for _ in 0...960 { samples.append(0.0) }
    for _ in 0...800 { engine.render(&samples[0:960]) }
    let state = engine.drive_state()!
    assert(state.gear == 1 && state.speed_kmh > 15.0)
    // Chevrolet wheel radius is 0.4 m. A locked driveline must satisfy this
    // independent kinematic relation regardless of acceleration or drag.
    let expected = state.speed_kmh as float64 / 3.6 / 0.4 * configuration.final_drive * configuration.ratios[0] * 60.0 / (2.0 * Math.pi<float64>())
    let relative_error = Math.abs(engine.current_rpm() as float64 - expected) / expected
    print("Coupled gearing: pont=", configuration.final_drive, " ratio=", configuration.ratios[0], " rpm=", engine.current_rpm(), " km/h=", state.speed_kmh, " relative error=", relative_error)
    assert(relative_error < 0.08, "configured gearing did not reach the driveline")
    var invalid = control; invalid.gear = configuration.ratios.count() + 1
    match try engine.set_controls(invalid) { failure(error) => {}; success => { panic("gear beyond custom gearbox accepted") } }
    engine.enqueue(1); engine.reset()
    assert(engine.pending_blocks() == 0 && engine.gearing.final_drive == configuration.final_drive)
    assert(engine.gearing.ratios.count() == configuration.ratios.count() && engine.controls().gear == 1)
    for _ in 0...800 { engine.render(&samples[0:960]) }
    assert(engine.drive_state()!.speed_kmh == state.speed_kmh, "reset did not preserve custom gearing")
}
func main() {
    let arguments = Process.arguments(); var directory = "Build/EngineLibrary-Gearing-Package"
    if arguments.count() > 1 { directory = arguments[1] }
    var library = Engines.Library.open(directory)
    rejected(library, Engines.Gearing(ratios:[], final_drive:3.0))
    rejected(library, Engines.Gearing(ratios:[1.0, 2.0], final_drive:3.0))
    rejected(library, Engines.Gearing(ratios:[2.0, 2.0], final_drive:3.0))
    rejected(library, Engines.Gearing(ratios:[0.0], final_drive:3.0))
    rejected(library, Engines.Gearing(ratios:[21.0], final_drive:3.0))
    rejected(library, Engines.Gearing(ratios:[1.0], final_drive:Math.sqrt(-1.0 as float64)))
    rejected(library, Engines.Gearing(ratios:[Math.sqrt(-1.0 as float64)], final_drive:3.0))
    rejected(library, Engines.Gearing(ratios:[1.0], final_drive:0.0))
    rejected(library, Engines.Gearing(ratios:[13.0, 12.0, 11.0, 10.0, 9.0, 8.0, 7.0, 6.0, 5.0, 4.0, 3.0, 2.0, 1.0], final_drive:3.0))
    let stock = library.profiles()[0].gearing
    match try library.engine(gearing:stock) { failure(error) => {}; success(value) => { panic("free bench accepted gearing") } }
    var legacy = Engines.Library.open("Build/EngineLibrary-Package")
    match try legacy.engine(transmission:Engines.Transmission.manual, gearing:stock) { failure(error) => {}; success(value) => { panic("v1 bank accepted unsupported gearing") } }
    stock_parity(library)
    coupled(library, Engines.Gearing(ratios:[2.97, 2.07], final_drive:3.73))
    coupled(library, Engines.Gearing(ratios:[2.97, 2.07], final_drive:5.0))
    coupled(library, Engines.Gearing(ratios:[4.0, 2.0], final_drive:3.73))
    print("Gearing checks passed: validation, legacy bank, stock PCM, independent coupling, gear bounds and reset")
}
