use GFX.Audio.Synthesis
use GFX.Audio.Synthesis.EngineParts
use Interop.C
use Interop.Boundary
use STD.Math

let phase = C.function<func() int32>(library:Boundary.System, name:"getppid")
func main() {
    print("empty"); phase(); phase()
    print("positive control"); phase()
    var positive:float32[] = []; for i in 0...1_024 { positive.append(i as float32) }
    phase(); assert(positive[1_023] == 1_023.0 as float32)
    print("assembly preparation"); phase()
    var parts = EngineParts.v8(); parts.turbo = EngineParts.Turbo()
    parts.head.ignition = EngineParts.Ignition.compression; parts.head.sharpness = 0.8
    parts.mechanics.clatter = 0.7; parts.mechanics.whine = 0.6
    for i in 0...parts.exhausts.count() {
        parts.exhausts[i].silencer.baffles = 8; parts.exhausts[i].expansion_litres = 3.0
    }
    var source = Synthesis.Engine.assemble(parts)
    var samples:float32[] = []; for _ in 0...960 { samples.append(0.0) }
    phase()
    print("first prepared block"); phase(); source.render(&samples[0:960]); phase()
    print("1000 blocks and state mix changes"); phase()
    for i in 0...1_000 {
        source.set_state(800.0 + (i % 500) as float32 * 11.0, throttle:0.8, load:0.6, boost:0.7)
        source.set_mix(EngineParts.Mix(exhaust:0.8, intake:(i % 100) as float32 / 100.0, mechanics:0.1, turbo:0.2))
        source.render(&samples[0:960])
    }
    phase()
    print("prepare a part replacement"); phase()
    parts.exhausts[0].pipe.length_mm = 500.0; source.set_parts(parts)
    parts.intake.filter_absorption = 0.05; source.set_parts(parts)
    parts.exhausts[0].pipe.length_mm = 1_000.0; source.set_parts(parts)
    phase()
    print("render part transition"); phase()
    for _ in 0...20 { source.render(&samples[0:960]) }
    phase()
    print("reset"); phase(); source.reset(); phase()
    for sample in samples { assert(Math.is_finite(sample) && Math.abs(sample) <= 0.4) }
}
