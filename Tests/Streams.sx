use GFX.Audio
use GFX.Audio.Native
use Interop.Boundary
use Interop.C
use STD.Error.Kind
use STD.Math
let generate = C.function<func(C.Pointer<uint8>, C.Pointer<uint8>, int32) int32>(library:Boundary.SDL3_mixer, name:"MIX_Generate")
func stream(audio:&Audio, capacity:int, channels:int = 1, rate:int = 48_000) Audio.Stream {
    match (try audio.stream(sample_rate:rate, channels:channels, capacity_frames:capacity)) {
        failure(error) => { panic(error.detail) }
        success(value) => { return value }
    }
}
func write(audio:&Audio, stream:Audio.Stream, samples:@float32[..]) int {
    match (try audio.write(stream, samples)) {
        failure(error) => { panic(error.detail) }
        success(count) => { return count }
    }
}
func info(audio:&Audio, stream:Audio.Stream) Audio.StreamInfo {
    match (try audio.stream_info(stream)) {
        failure(error) => { panic(error.detail) }
        success(value) => { return value }
    }
}
func close(audio:&Audio, stream:Audio.Stream) {
    match (try audio.close(stream)) { failure(error) => { panic(error.detail) }; success => {} }
}
test "stream copies blocks applies backpressure and resumes one PCM timeline" {
    Native.initialize()
    let mixer = Native.create_offline_mixer(48_000, 1)
    var audio = Audio(native_mixer:mixer)
    let source = stream(audio, 3)
    var block:float32[] = [0.25 as float32, 0.5 as float32, -0.5 as float32, 1.0 as float32]
    assert(write(audio, source, @block[0:4]) == 3)
    block[0] = 0.0 as float32
    match (try audio.write(source, @block[3:4])) {
        success(count) => { panic("full queue accepted input") }
        failure(error) => { assert(error.kind == Kind.would_block()) }
    }
    assert(info(audio, source).queued_frames == 3)
    let playing = audio.play(source)
    var output:uint[2]
    let out = C.address_bits(C.mutable_pointer(output))
    assert(generate(C.pointer_bits(mixer), C.pointer_bits(out), 8) == 8)
    assert(C.load<float32>(out, 0 as uint) == 0.25 as float32)
    assert(C.load<float32>(out, 4 as uint) == 0.5 as float32)
    assert(info(audio, source).consumed_frames == 2)
    audio.pause(playing)
    match (try audio.wait_writable(source, minimum_frames:3)) {
        success => { panic("paused full stream waited forever") }
        failure(error) => { assert(error.kind == Kind.resource_busy()) }
    }
    assert(generate(C.pointer_bits(mixer), C.pointer_bits(out), 4) == 0)
    assert(info(audio, source).consumed_frames == 2)
    audio.resume(playing)
    assert(generate(C.pointer_bits(mixer), C.pointer_bits(out), 4) == 4)
    assert(C.load<float32>(out, 0 as uint) == -0.5 as float32)
    assert(generate(C.pointer_bits(mixer), C.pointer_bits(out), 4) == 0)
    assert(C.load<float32>(out, 0 as uint) == 0.0 as float32)
    assert(info(audio, source).starved)
    assert(audio.is_playing(playing))
    assert(write(audio, source, @block[3:4]) == 1)
    block.clear()
    close(audio, source)
    assert(generate(C.pointer_bits(mixer), C.pointer_bits(out), 4) == 4)
    assert(C.load<float32>(out, 0 as uint) == 1.0 as float32)
    let final = info(audio, source)
    assert(final.written_frames == 4 && final.consumed_frames == 4 && final.queued_frames == 0)
    assert(final.closed && final.drained && !final.starved)
    assert(!audio.is_playing(playing))
    assert(audio.release(source))
    assert(!audio.release(playing))
}
test "stereo short blocks reject partial frames and preserve channel order" {
    Native.initialize()
    let mixer = Native.create_offline_mixer(24_000, 2)
    var audio = Audio(native_mixer:mixer)
    let source = stream(audio, 2, channels:2, rate:24_000)
    var samples:float32[] = [0.25 as float32, -0.25 as float32, 0.5 as float32, -0.5 as float32]
    match (try audio.write(source, @samples[0:1])) {
        success(count) => { panic("partial stereo frame accepted") }
        failure(error) => { assert(error.kind == Kind.invalid_input()) }
    }
    assert(write(audio, source, @samples[0:2]) == 1)
    assert(write(audio, source, @samples[2:4]) == 1)
    close(audio, source)
    let playing = audio.play(source)
    var output:uint[2]
    let out = C.address_bits(C.mutable_pointer(output))
    assert(generate(C.pointer_bits(mixer), C.pointer_bits(out), 16) == 16)
    var index = 0
    while index < 4 {
        assert(C.load<float32>(out, (index * 4) as uint) == samples[index])
        index++
    }
    assert(info(audio, source).drained)
}

test "stream stop discards pending frames and stale identities never target a reused slot" {
    Native.initialize()
    let mixer = Native.create_offline_mixer(48_000, 1)
    var audio = Audio(native_mixer:mixer)
    let source = stream(audio, 4)
    var samples:float32[] = [0.25 as float32, 0.5 as float32, 0.75 as float32]
    assert(write(audio, source, @samples[0:3]) == 3)
    let playing = audio.play(source)
    var output:uint[2]
    let out = C.address_bits(C.mutable_pointer(output))
    assert(generate(C.pointer_bits(mixer), C.pointer_bits(out), 4) == 4)
    audio.stop(playing)
    let stopped = info(audio, source)
    assert(stopped.consumed_frames == 1 && stopped.discarded_frames == 2 && stopped.queued_frames == 0)
    assert(!stopped.drained)
    assert(audio.release(source))
    let next = stream(audio, 4)
    match (try audio.write(source, @samples[0:1])) {
        success(count) => { panic("stale stream accepted input") }
        failure(error) => { assert(error.kind == Kind.invalid_input()) }
    }
    assert(write(audio, next, @samples[0:1]) == 1)
    assert(!audio.release(source))
    var other = Audio()
    match (try other.stream_info(next)) {
        success(value) => { panic("foreign owner accepted stream") }
        failure(error) => { assert(error.kind == Kind.invalid_input()) }
    }
}
test "closed input rejects writes and empty close terminates after start" {
    Native.initialize()
    let mixer = Native.create_offline_mixer(48_000, 1)
    var audio = Audio(native_mixer:mixer)
    let source = stream(audio, 1)
    close(audio, source)
    close(audio, source)
    var samples:float32[] = [0.0 as float32]
    match (try audio.write(source, @samples[0:1])) {
        success(count) => { panic("closed stream accepted input") }
        failure(error) => { assert(error.kind == Kind.invalid_input()) }
    }
    let playing = audio.play(source)
    assert(!audio.is_playing(playing))
    assert(info(audio, source).drained)
}

test "closed blocks match a complete source across sample rate conversion" {
    Native.initialize()
    let mixer = Native.create_offline_mixer(48_000, 1)
    let reference_mixer = Native.create_offline_mixer(48_000, 1)
    var audio = Audio(native_mixer:mixer)
    let source = stream(audio, 128, rate:24_000)
    var samples:float32[] = []
    var index = 0
    while index < 128 {
        samples.append(((index % 16) as float / 32.0 - 0.25) as float32)
        index++
    }
    assert(write(audio, source, @samples[0:63]) == 63)
    assert(write(audio, source, @samples[63:128]) == 65)
    close(audio, source)
    let playing = audio.play(source)
    let reference = Native.create(reference_mixer, @samples[0:128], 24_000, 1)
    let reference_track = Native.create_track(reference_mixer, reference)
    Native.play(reference_track, 0, 0.0)
    var actual:uint[128]
    var expected:uint[128]
    let a = C.address_bits(C.mutable_pointer(actual))
    let b = C.address_bits(C.mutable_pointer(expected))
    let actual_count = generate(C.pointer_bits(mixer), C.pointer_bits(a), 1024)
    let expected_count = generate(C.pointer_bits(reference_mixer), C.pointer_bits(b), 1024)
    assert(actual_count == expected_count)
    assert(actual_count == 1024)
    index = 0
    while index < 256 {
        assert(C.load<float32>(a, (index * 4) as uint) == C.load<float32>(b, (index * 4) as uint))
        index++
    }
    assert(info(audio, source).drained)
    Native.destroy_track(reference_track)
    Native.destroy_audio(reference)
    Native.destroy_mixer(reference_mixer)
}

test "invalid stream configuration samples and waits return recoverable errors" {
    var audio = Audio()
    match (try audio.stream(sample_rate:0)) {
        success(value) => { panic("invalid sample rate accepted") }
        failure(error) => { assert(error.kind == Kind.invalid_input()) }
    }
    match (try audio.stream(sample_rate:48_000, channels:9)) {
        success(value) => { panic("invalid channel count accepted") }
        failure(error) => { assert(error.kind == Kind.invalid_input()) }
    }
    match (try audio.stream(sample_rate:48_000, capacity_frames:2_147_483_647)) {
        success(value) => { panic("overflowing capacity accepted") }
        failure(error) => { assert(error.kind == Kind.invalid_input()) }
    }
    let source = stream(audio, 1)
    var bad:float32[] = [2.0 as float32]
    match (try audio.write(source, @bad[0:1])) {
        success(count) => { panic("invalid amplitude accepted") }
        failure(error) => { assert(error.kind == Kind.invalid_input()) }
    }
    bad[0] = Math.sqrt(-1.0) as float32
    match (try audio.write(source, @bad[0:1])) {
        success(count) => { panic("NaN accepted by stream") }
        failure(error) => { assert(error.kind == Kind.invalid_input()) }
    }
    bad[0] = Math.exp(1_000.0) as float32
    match (try audio.write(source, @bad[0:1])) {
        success(count) => { panic("infinity accepted by stream") }
        failure(error) => { assert(error.kind == Kind.invalid_input()) }
    }
    var empty:float32[] = []
    assert(write(audio, source, @empty[0:0]) == 0)
    var valid:float32[] = [0.0 as float32]
    assert(write(audio, source, @valid[0:1]) == 1)
    match (try audio.wait_writable(source)) {
        success => { panic("unstarted full stream waited forever") }
        failure(error) => { assert(error.kind == Kind.resource_busy()) }
    }
    match (try audio.wait_writable(source, minimum_frames:2)) {
        success => { panic("impossible space accepted") }
        failure(error) => { assert(error.kind == Kind.invalid_input()) }
    }
}

test "drain retains the resampler tail across small mixer requests" {
    Native.initialize()
    let mixer = Native.create_offline_mixer(48_000, 1)
    var audio = Audio(native_mixer:mixer)
    let source = stream(audio, 128, rate:24_000)
    var samples:float32[] = []
    var index = 0
    while index < 128 { samples.append(0.25 as float32); index++ }
    assert(write(audio, source, @samples[0:128]) == 128)
    close(audio, source)
    let playing = audio.play(source)
    var output:uint[4]
    let out = C.address_bits(C.mutable_pointer(output))
    var rendered = 0
    while rendered < 256 {
        let count = generate(C.pointer_bits(mixer), C.pointer_bits(out), 32)
        assert(count == 32)
        rendered += 8

        assert(info(audio, source).drained == (rendered == 256))
        assert(audio.is_playing(playing) == (rendered < 256))
        audio.collect_finished()
    }
    assert(audio.release(source))
}

test "finished sounds retain converted output until the final small mixer request" {
    Native.initialize()
    let mixer = Native.create_offline_mixer(48_000, 1)
    var audio = Audio(native_mixer:mixer)
    var samples:float32[] = []
    var index = 0
    while index < 128 { samples.append(0.25 as float32); index++ }
    let sound = audio.create(@samples[0:128], sample_rate:24_000)
    let playing = audio.play(sound)
    var output:uint[4]
    let out = C.address_bits(C.mutable_pointer(output))
    var rendered = 0
    while rendered < 256 {
        assert(generate(C.pointer_bits(mixer), C.pointer_bits(out), 32) == 32)
        rendered += 8
        assert(audio.is_playing(playing) == (rendered < 256))
        audio.collect_finished()
    }
    assert(audio.unload(sound))
}
