use GFX.Audio
use GFX.Audio.Processing
use GFX.Audio.Synthesis
use STD.Error

func require(result:Result<void, Error>) { match result { failure(error) => { panic(error.detail) }; success => {} } }
func format() Processing.Format { return Processing.Format(sample_rate:48_000, channels:2) }
func play(audio:&Audio, samples:&float32[..], name:str) {
    print(name)
    var i = 0
    while i < samples.count() { samples[i] *= 0.18; i++ }
    let sound = audio.create(@samples[0:samples.count()], sample_rate:48_000, channels:2)
    audio.wait(audio.play(sound)); assert(audio.unload(sound))
}
func example(audio:&Audio, position:float32, sweep:bool, name:str) {
    var frames = 48_000
    if sweep { frames = 50_400 }
    var samples:float32[] = []; var i = 0
    while i < frames * 2 { samples.append(0.0); i++ }
    match (try Synthesis.Oscillator.create(format(), frequency_hz:440.0, amplitude:0.35)) {
        failure(error) => { panic(error.detail) }; success(var source) => { require((try source.render(&samples[0:samples.count()]))) }
    }
    match (try Processing.StereoPan.create(format(), pan:position)) {
        failure(error) => { panic(error.detail) }
        success(var effect) => {
            if sweep {
                var step = 0
                while step < 21 {
                    require((try effect.set_pan(-1.0 + step as float32 * 0.1)))
                    require((try effect.process(&samples[step * 4_800:(step + 1) * 4_800])))
                    step++
                }
            } else { require((try effect.process(&samples[0:samples.count()]))) }
        }
    }
    match (try Synthesis.Envelope.create(format(), attack_frames:480, decay_frames:4_800, sustain:0.7, release_frames:4_800)) {
        failure(error) => { panic(error.detail) }
        success(var envelope) => {
            envelope.note_on(); require((try envelope.process(&samples[0:(frames - 4_800) * 2])))
            envelope.note_off(); require((try envelope.process(&samples[(frames - 4_800) * 2:samples.count()])))
        }
    }
    play(audio, &samples[0:samples.count()], name)
}
func main() {
    var audio = Audio()
    example(audio, position:-1.0, sweep:false, name:"P1 - Both channels to the left")
    example(audio, position:0.0, sweep:false, name:"P2 - Original stereo center")
    example(audio, position:1.0, sweep:false, name:"P3 - Both channels to the right")
    example(audio, position:-1.0, sweep:true, name:"P4 - Left to right across prepared blocks")
}
