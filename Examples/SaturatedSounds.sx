use GFX.Audio
use GFX.Audio.Processing
use GFX.Audio.Synthesis
use STD.Error

func require(result:Result<void, Error>) { match result { failure(error) => { panic(error.detail) }; success => {} } }
func format() Processing.Format { return Processing.Format(sample_rate:48_000, channels:1) }
func play(audio:&Audio, samples:&float32[..], name:str) {
    print(name)
    var i = 0
    while i < samples.count() { samples[i] *= 0.18; i++ }
    let sound = audio.create(@samples[0:samples.count()], sample_rate:48_000)
    audio.wait(audio.play(sound)); assert(audio.unload(sound))
}
func example(audio:&Audio, mode:Processing.DistortionMode, drive:float32, bypass:bool, name:str) {
    match Synthesis.Oscillator.create(format(), frequency_hz:220.0, amplitude:0.75) {
        failure(error) => { panic(error.detail) }
        success(var source) => {
            var samples:float32[] = []; var i = 0
            while i < 48_000 { samples.append(0.0); i++ }
            require(source.render(&samples[0:48_000]))
            match Processing.Distortion.create(format(), drive, mode) {
                failure(error) => { panic(error.detail) }
                success(var effect) => { effect.set_bypass(bypass); require(effect.process(&samples[0:48_000])) }
            }
            match Synthesis.Envelope.create(format(), attack_frames:480, decay_frames:4_800, sustain:0.7, release_frames:4_800) {
                failure(error) => { panic(error.detail) }
                success(var envelope) => {
                    envelope.note_on(); require(envelope.process(&samples[0:43_200]))
                    envelope.note_off(); require(envelope.process(&samples[43_200:48_000]))
                }
            }
            play(audio, &samples[0:48_000], name)
        }
    }
}
func main() {
    var audio = Audio()
    example(audio, Processing.DistortionMode.soft, drive:2.0, bypass:true, name:"S1 - Sine reference")
    example(audio, Processing.DistortionMode.soft, drive:2.0, bypass:false, name:"S2 - Soft saturation, drive 2")
    example(audio, Processing.DistortionMode.soft, drive:8.0, bypass:false, name:"S3 - Soft saturation, drive 8")
    example(audio, Processing.DistortionMode.hard, drive:8.0, bypass:false, name:"S4 - Hard clipping, drive 8")
}
