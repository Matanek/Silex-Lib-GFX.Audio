use GFX.Audio.Engines
use GFX.Audio.Engines.Vehicles
use STD.Math
use STD.Process

// Render without an audio device. Use AudioEngineSimulator to listen to the demo presets.
func main() {
    let arguments = Process.arguments()
    var key = "454"; if arguments.count() > 1 { key = arguments[1] }
    var source = Vehicles.create(key)
    var controls = source.controls(); controls.running = true; controls.throttle = 0.6
    source.set_controls(controls)
    var samples:float32[] = []; for _ in 0...960 { samples.append(0.0) }
    var energy:float64 = 0.0
    for _ in 0...360 {
        source.render(&samples[0:960])
        for sample in samples { assert(Math.is_finite(sample)); energy += sample as float64 * sample as float64 }
    }
    assert(energy > 0.001)
    print(key, ": ", source.current_rpm(), " rpm; ", energy, " PCM energy")
}
