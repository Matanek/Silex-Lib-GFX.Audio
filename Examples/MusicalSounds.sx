use GFX.Audio
use GFX.Audio.Music
use GFX.Audio.Processing
use GFX.Audio.Synthesis
use STD.Error

// An application instrument chooses its own articulation and note dynamics.
class SoftAccent:Synthesis.Instrument {
    let format:Processing.Format
    private var source:Synthesis.SineInstrument
    private init(source:Synthesis.SineInstrument) { self.source = source; self.format = source.format }
    static func create() Result<SoftAccent, Error> {
        var source = try Music.Instruments.sine(amplitude:0.22,
            attack_seconds:0.003, decay_seconds:0.03, sustain:0.3, release_seconds:0.1)
        return Result<SoftAccent, Error>.success(SoftAccent(source))
    }
    func validate(command:Synthesis.Command) Result<void, Error> { return self.source.validate(command) }
    func send(command:Synthesis.Command) Result<void, Error> {
        match command {
            note_on(id, frequency, velocity) => { return self.source.send(Synthesis.Command.note_on(id, frequency, velocity * velocity)) }
            else => { return self.source.send(command) }
        }
    }
    func render(samples:&float32[..]) Result<void, Error> { return self.source.render(samples) }
    func reset() { self.source.reset() }
}

func main() {
    var audio = Audio()
    let keys = try Music.keys(["C5", "E5", "G5", "C6"]) else error { panic(error.detail) }
    var melody = try Music.Melody.create([
        Music.Note(key:keys[0], beats:0.5), Music.Note(key:keys[1], beats:0.5),
        Music.Note(key:keys[2], beats:0.5), Music.Note(key:keys[3], beats:1.25),
    ], tempo:187.5) else error { panic(error.detail) }
    let victory = try melody.prepare(audio) else error { panic(error.detail) }
    print("Retro victory, prepared once")
    audio.wait(audio.play(victory))

    var timbre = Music.Timbre.soft()
    timbre.release_seconds = 0.15
    timbre.amplitude = 0.16
    let softer = try melody.prepare(audio, using:timbre) else error { panic(error.detail) }
    print("Same melody, customized soft timbre")
    audio.wait(audio.play(softer))

    var instrument = try Music.Instruments.sine(amplitude:0.16,
        attack_seconds:0.003, decay_seconds:0.03, sustain:0.35, release_seconds:0.1)
        else error { panic(error.detail) }
    let tone = try melody.prepare(audio, using:instrument, tail_seconds:0.1)
        else error { panic(error.detail) }
    print("Same melody, integrated polyphonic sine instrument")
    audio.wait(audio.play(tone))

    var accent = try SoftAccent.create() else error { panic(error.detail) }
    let personal = try melody.prepare(audio, using:accent, tail_seconds:0.1) else error { panic(error.detail) }
    print("Same preparation and playback, application instrument")
    audio.wait(audio.play(personal))
    assert(audio.unload(victory) && audio.unload(softer) && audio.unload(tone) && audio.unload(personal))
}
