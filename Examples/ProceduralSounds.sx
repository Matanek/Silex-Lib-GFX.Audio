use GFX.Audio
use GFX.Audio.Synthesis
use GFX.Audio.Processing
use STD.Error

func require(result:Result<void, Error>) {
    match result { failure(error) => { panic(error.detail) }; success => {} }
}

func oscillator(format:Processing.Format, frequency:float32, amplitude:float32) Synthesis.Oscillator {
    match (try Synthesis.Oscillator.create(format, frequency_hz:frequency, amplitude:amplitude)) {
        failure(error) => { panic(error.detail) }; success(value) => { return value }
    }
}

func contour(format:Processing.Format, attack:int, decay:int, sustain:float32, release:int) Synthesis.Envelope {
    match (try Synthesis.Envelope.create(format, attack_frames:attack, decay_frames:decay, sustain:sustain, release_frames:release)) {
        failure(error) => { panic(error.detail) }; success(value) => { return value }
    }
}

func shaped(source:Synthesis.Generator, envelope:Synthesis.Envelope, frames:int, gate_frames:int) float32[] {
    var samples:float32[] = []
    var i = 0
    while i < frames { samples.append(0.0); i++ }
    require((try source.render(&samples[0:frames])))
    envelope.note_on()
    require((try envelope.process(&samples[0:gate_frames])))
    envelope.note_off()
    require((try envelope.process(&samples[gate_frames:frames])))
    assert(!envelope.is_active())
    return samples
}

func beep(format:Processing.Format) float32[] {
    var source = oscillator(format, frequency:660.0, amplitude:0.15)
    var envelope = contour(format, attack:240, decay:2_400, sustain:0.65, release:5_760)
    return shaped(source, envelope, frames:14_160, gate_frames:8_400)
}

func impact(format:Processing.Format) float32[] {
    var bass = oscillator(format, frequency:65.0, amplitude:0.25)
    var bass_envelope = contour(format, attack:48, decay:0, sustain:1.0, release:12_000)
    var samples = shaped(bass, bass_envelope, frames:12_480, gate_frames:480)
    match (try Synthesis.WhiteNoise.create(format, seed:42, amplitude:0.15)) {
        failure(error) => { panic(error.detail) }
        success(var noise) => {
            var envelope = contour(format, attack:48, decay:0, sustain:1.0, release:7_200)
            var texture = shaped(noise, envelope, frames:12_480, gate_frames:480)
            match (try Processing.LowPass.create(format, cutoff_hz:1_200.0)) {
                failure(error) => { panic(error.detail) }
                success(var filter) => { require((try filter.process(&texture[0:texture.count()]))) }
            }
            var i = 0
            while i < samples.count() { samples[i] += texture[i]; i++ }
        }
    }
    return samples
}

func play(audio:&Audio, samples:@float32[..]) {
    let sound = audio.create(samples, sample_rate:48_000)
    let playing = audio.play(sound)
    audio.wait(playing)
    assert(audio.unload(sound))
}

func main() {
    let format = Processing.Format(sample_rate:48_000, channels:1)
    var tone = beep(format)
    var hit = impact(format)
    var audio = Audio()
    print("Procedural beep: sine with ADSR")
    play(audio, @tone[0:tone.count()])
    print("Procedural impact: bass and seeded filtered noise")
    play(audio, @hit[0:hit.count()])
}
