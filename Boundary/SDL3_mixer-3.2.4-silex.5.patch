+// Private provider extension: mixing is complete only after queued output drains.
+bool SDLCALL Silex_MIX_TrackDrained(MIX_Track *track)
+{
+    if (!CheckTrackParam(track)) {
+        return false;
+    }
+    LockTrack(track);
+    const bool result = track->state == MIX_STATE_STOPPED &&
+        SDL_GetAudioStreamAvailable(track->output_stream) == 0;
+    UnlockTrack(track);
+    return result;
+}
+
+// Private provider extension: finalize a live stream without restarting its track.
+bool SDLCALL Silex_MIX_CloseTrackStream(MIX_Track *track)
+{
+    if (!CheckTrackParam(track)) {
+        return false;
+    }
+    LockTrack(track);
+    bool result = false;
+    if (track->input_stream && !track->input_audio) {
+        result = SDL_FlushAudioStream(track->input_stream);
+        if (result) {
+            track->silex_stream_closed = true;
+        }
+    } else {
+        SDL_SetError("Track does not have an external audio stream");
+    }
+    UnlockTrack(track);
+    return result;
 }
 
