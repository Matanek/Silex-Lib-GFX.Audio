let sdl_destroy_audio_stream = C.function<func(C.Pointer<uint8>) void>(library:Boundary.SDL3, name:"SDL_DestroyAudioStream")
let sdl_set_boolean_property = C.function<func(uint32, C.Pointer<uint8>, uint8) uint8>(library:Boundary.SDL3, name:"SDL_SetBooleanProperty")

func clear_stream(stream:uint) { require(sdl_clear_audio_stream(C.pointer_bits(stream)) != 0, "discard queued stream input") }
let sdl_clear_audio_stream = C.function<func(C.Pointer<uint8>) uint8>(library:Boundary.SDL3, name:"SDL_ClearAudioStream")

let mix_track_drained = C.function<func(C.Pointer<uint8>) uint8>(library:Boundary.SDL3_mixer, name:"Silex_MIX_TrackDrained")

struct SourceFormat { let sample_rate:int; let channels:int }
func sound_format(audio:uint) SourceFormat {
    var spec:uint[2]
    let ptr = C.address_bits(C.mutable_pointer(spec))
    require(mix_get_audio_format(C.pointer_bits(audio), C.pointer_bits(ptr)) != 0, "query source format")
    return SourceFormat(sample_rate:C.load<int32>(ptr, 8 as uint) as int, channels:C.load<int32>(ptr, 4 as uint) as int)
}
func sound_duration(audio:uint) int { return mix_get_audio_duration(C.pointer_bits(audio)) }
func seek_frames(track:uint, frame:int) bool { return mix_set_track_playback_position(C.pointer_bits(track), frame) != 0 }
let mix_get_audio_format = C.function<func(C.Pointer<uint8>, C.Pointer<uint8>) uint8>(library:Boundary.SDL3_mixer, name:"MIX_GetAudioFormat")
let mix_get_audio_duration = C.function<func(C.Pointer<uint8>) int>(library:Boundary.SDL3_mixer, name:"MIX_GetAudioDuration")
let mix_set_track_playback_position = C.function<func(C.Pointer<uint8>, int) uint8>(library:Boundary.SDL3_mixer, name:"MIX_SetTrackPlaybackPosition")

let mix_lock_mixer = C.function<func(C.Pointer<uint8>) void>(library:Boundary.SDL3_mixer, name:"MIX_LockMixer")
let mix_unlock_mixer = C.function<func(C.Pointer<uint8>) void>(library:Boundary.SDL3_mixer, name:"MIX_UnlockMixer")

func create_offline_mixer(sample_rate:int, channels:int) uint {
    let mixer = try_create_offline_mixer(sample_rate, channels)
    if mixer == 0 as uint { panic("GFX.Audio could not create an offline mixer: " + error()) }
    return mixer
}
func render(mixer:uint, samples:int) Result<float32[], Error> {
    let bytes = samples * 4
    let data = C.address_bits(sdl_malloc(bytes as C.Size))
    if data == 0 as uint { return Result<float32[], Error>.failure(Error(kind:Kind.resource_exhausted(), operation:"audio.render", subject:null, detail:error())) }
    let mixed = mix_generate(C.pointer_bits(mixer), C.pointer_bits(data), bytes as int32)
    if mixed < 0 {
        let detail = error()
        sdl_free(C.pointer_bits(data))
        return Result<float32[], Error>.failure(Error(kind:Kind.other(), operation:"audio.render", subject:null, detail:detail))
    }
    var output:float32[] = []
    var index = 0
    while index < samples { output.append(C.load<float32>(data, (index * 4) as uint)); index++ }
    sdl_free(C.pointer_bits(data))
    return Result<float32[], Error>.success(output)
}
let mix_generate = C.function<func(C.Pointer<uint8>, C.Pointer<uint8>, int32) int32>(library:Boundary.SDL3_mixer, name:"MIX_Generate")

let sdl_get_audio_stream_properties = C.function<func(C.Pointer<uint8>) uint32>(library:Boundary.SDL3, name:"SDL_GetAudioStreamProperties")

func output_format(mixer:uint) SourceFormat {
    var spec:uint[2]
    let ptr = C.address_bits(C.mutable_pointer(spec))
    require(mix_get_mixer_format(C.pointer_bits(mixer), C.pointer_bits(ptr)) != 0, "query mixer format")
    return SourceFormat(sample_rate:C.load<int32>(ptr, 8 as uint) as int, channels:C.load<int32>(ptr, 4 as uint) as int)
}
