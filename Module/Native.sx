// SDL core calls use the parent provider directly; SDL3_mixer privately
// requires the same provider for its own implementation.
let sdl_init_subsystem = C.function<func(uint32) uint8>(library:Boundary.SDL3, name:"SDL_InitSubSystem")
let sdl_quit_subsystem = C.function<func(uint32) void>(library:Boundary.SDL3, name:"SDL_QuitSubSystem")
let sdl_create_properties = C.function<func() uint32>(library:Boundary.SDL3, name:"SDL_CreateProperties")
let sdl_destroy_properties = C.function<func(uint32) void>(library:Boundary.SDL3, name:"SDL_DestroyProperties")
let sdl_set_number_property = C.function<func(uint32, C.Pointer<uint8>, int) uint8>(library:Boundary.SDL3, name:"SDL_SetNumberProperty")
let sdl_get_error = C.function<func() C.Pointer<uint8> >(library:Boundary.SDL3, name:"SDL_GetError")
let sdl_delay = C.function<func(uint32) void>(library:Boundary.SDL3, name:"SDL_Delay")
let sdl_malloc = C.function<func(C.Size) C.Pointer<uint8> >(library:Boundary.SDL3, name:"SDL_malloc")
let sdl_free = C.function<func(C.Pointer<uint8>) void>(library:Boundary.SDL3, name:"SDL_free")

let sdl_io_from_const_mem = C.function<func(C.Pointer<uint8>, C.Size) C.Pointer<uint8> >(library:Boundary.SDL3, name:"SDL_IOFromConstMem")
let mix_load_audio_io = C.function<func(C.Pointer<uint8>, C.Pointer<uint8>, uint8, uint8) C.Pointer<uint8> >(library:Boundary.SDL3_mixer, name:"MIX_LoadAudio_IO")

func try_create_offline_mixer(sample_rate:int, channels:int) uint {
    var spec:uint[2]
    let address = C.address_bits(C.mutable_pointer(spec))
    let f = C.store<uint32>(address, 0 as uint, 0x8120 as uint32)
    let c = C.store<int32>(address, 4 as uint, channels as int32)
    let hz = C.store<int32>(address, 8 as uint, sample_rate as int32)
    return C.address_bits(mix_create_mixer(C.pointer_bits(address)))
}

func create_stream(sample_rate:int, channels:int) uint {
    var spec:uint[2]
    let address = C.address_bits(C.mutable_pointer(spec))
    let f = C.store<uint32>(address, 0 as uint, 0x8120 as uint32)
    let c = C.store<int32>(address, 4 as uint, channels as int32)
    let hz = C.store<int32>(address, 8 as uint, sample_rate as int32)
    let input = C.address_bits(sdl_create_audio_stream(C.pointer_bits(address), C.pointer_bits(address)))
    if input != 0 as uint && sdl_set_boolean_property(sdl_get_audio_stream_properties(C.pointer_bits(input)), C.terminated_pointer("SDL.audiostream.auto_cleanup"), 0) == 0 {
        sdl_destroy_audio_stream(C.pointer_bits(input))
        return 0 as uint
    }
    return input
}

func create_stream_track(mixer:uint, stream:uint) uint {
    let track = C.address_bits(mix_create_track(C.pointer_bits(mixer)))
    if track == 0 as uint { return 0 as uint }
    if mix_set_track_audio_stream(C.pointer_bits(track), C.pointer_bits(stream)) == 0 {
        mix_destroy_track(C.pointer_bits(track))
        return 0 as uint
    }
    return track
}

func put_samples(stream:uint, samples:@float32[..]) bool {
    let bytes = samples.count() * 4
    let data = C.address_bits(sdl_malloc(bytes as C.Size))
    if data == 0 as uint { return false }
    var index = 0
    while index < samples.count() {
        let stored = C.store<float32>(data, (index * 4) as uint, samples[index])
        index++
    }
    let result = sdl_put_audio_stream_data(C.pointer_bits(stream), C.pointer_bits(data), bytes as int32) != 0
    sdl_free(C.pointer_bits(data))
    return result
}

func play_stream(track:uint, fade_in_seconds:float, paused:bool = false) {
    let props = sdl_create_properties()
    if props == 0 { panic("GFX.Audio could not configure stream playback: " + error()) }
    var configured = sdl_set_boolean_property(props, C.terminated_pointer("SDL_mixer.play.halt_when_exhausted"), 0) != 0
    if fade_in_seconds > 0.0 {
        configured = configured && sdl_set_number_property(props, C.terminated_pointer("SDL_mixer.play.fade_in_milliseconds"), seconds_to_milliseconds(fade_in_seconds)) != 0
    }
    let mixer = C.address_bits(mix_get_track_mixer(C.pointer_bits(track)))
    mix_lock_mixer(C.pointer_bits(mixer))
    var started = configured && mix_play_track(C.pointer_bits(track), props) != 0
    if started && paused { started = mix_pause_track(C.pointer_bits(track)) != 0 }
    mix_unlock_mixer(C.pointer_bits(mixer))
    sdl_destroy_properties(props)
    require(started, "start stream playback")
}

func close_stream(track:uint) bool { return mix_close_track_stream(C.pointer_bits(track)) != 0 }
func destroy_stream(stream:uint) { sdl_destroy_audio_stream(C.pointer_bits(stream)) }
func playback_frames(track:uint) int { return mix_get_track_playback_position(C.pointer_bits(track)) }

