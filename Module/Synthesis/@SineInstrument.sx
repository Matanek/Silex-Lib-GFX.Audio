use GFX.Audio.Processing
use STD.Error
use STD.Error.Kind
use STD.Math

class SineVoice:InstrumentVoice {
    var id:int = -1
    var order:int = 0
    var held:bool = false
    var frequency:float32 = 0.0
    private let rate:float32
    private var phase:float32 = 0.0
    private var velocity:float32 = 0.0
    private var last:float32 = 0.0
    private var tail:float32 = 0.0
    private var fading:int = 0
    private let fade_frames:int
    private var envelope:Envelope

    init(envelope:Envelope, fade_frames:int) { self.envelope = envelope; self.fade_frames = fade_frames; self.rate = envelope.format.sample_rate as float32 }
    func occupied() bool { return self.envelope.is_active() || self.fading > 0 }
    func start(id:int, frequency:float32, velocity:float32, order:int) {
        let replacing = self.occupied()
        self.tail = 0.0; self.fading = 0
        if replacing && self.fade_frames > 0 { self.tail = self.last; self.fading = self.fade_frames }
        self.id = id; self.frequency = frequency; self.velocity = velocity
        self.order = order; self.held = true; self.phase = 0.0; self.envelope.note_on()
    }
    func release() { self.envelope.note_off() }
    func render(samples:&float32[..], ratios:@float32[..]) Result<void, Error> {
        var i = 0
        while i < samples.count() {
            samples[i] = self.velocity * Math.sin(self.phase * 6.283185307179586)
            self.phase += self.frequency * ratios[i] / self.rate
            if self.phase >= 1.0 { self.phase -= 1.0 }
            i++
        }
        try self.envelope.process(samples)
        i = 0
        while i < samples.count() {
            if self.fading > 0 {
                let weight = self.fading as float32 / self.fade_frames as float32
                samples[i] = weight * self.tail + (1.0 - weight) * samples[i]
                self.fading--
            }
            self.last = samples[i]; i++
        }
        return Result<void, Error>.success()
    }
    func reset() {
        self.envelope.reset(); self.id = -1; self.held = false; self.order = 0
        self.phase = 0.0; self.last = 0.0; self.tail = 0.0; self.fading = 0
    }
}

public class SineInstrument:Generator, Instrument {
    let format:Processing.Format
    let amplitude:float32
    let max_voices:int
    let voice_policy:VoicePolicy
    let steal_fade_frames:int
    private var pool:PolyphonicInstrument
    private init(pool:PolyphonicInstrument) {
        self.pool = pool; self.format = pool.format; self.amplitude = pool.amplitude
        self.max_voices = pool.max_voices; self.voice_policy = pool.voice_policy
        self.steal_fade_frames = pool.steal_fade_frames
    }
    static func create(format:Processing.Format, max_voices:int = 16, voice_policy:VoicePolicy = VoicePolicy.steal_oldest, attack_frames:int = 240, decay_frames:int = 2_400, sustain:float32 = 0.7, release_frames:int = 4_800, steal_fade_frames:int = 32, amplitude:float32 = 1.0) Result<SineInstrument, Error> {
        if !valid_format(format) || max_voices < 1 || max_voices > 64 || steal_fade_frames < 0 || steal_fade_frames > 4_096 || !Math.is_finite(amplitude) || amplitude < 0.0 || amplitude > 1.0 { return Result<SineInstrument, Error>.failure(invalid("instrument requires a valid format, 1 to 64 voices, unit amplitude and steal fade in [0, 4096] frames")) }
        var voices:InstrumentVoice[] = []
        var i = 0
        while i < max_voices {
            var envelope = try Envelope.create(Processing.Format(sample_rate:format.sample_rate, channels:1), attack_frames, decay_frames, sustain, release_frames)
            voices.append(SineVoice(envelope, steal_fade_frames)); i++
        }
        return Result<SineInstrument, Error>.success(SineInstrument(PolyphonicInstrument(format, voices, voice_policy, steal_fade_frames, amplitude)))
    }
    func validate(command:Command) Result<void, Error> { return self.pool.validate(command) }
    func send(command:Command) Result<void, Error> { return self.pool.send(command) }
    func active_voices() int { return self.pool.active_voices() }
    func render(samples:&float32[..]) Result<void, Error> { return self.pool.render(samples) }
    func reset() { self.pool.reset() }
}
