use GFX.Audio.Synthesis.EngineParts
use STD.Math

// Acoustic archetypes, not measured replicas of production vehicles.
public struct Profile {
    var id:str
    var name:str
    var parts:EngineParts.Assembly
    var idle_rpm:float32
    var redline_rpm:float32
    var response_seconds:float32
    var roughness:float32 = 0.2
}

func motor(id:str, name:str, cylinders:int, litres:float32, idle:float32, redline:float32,
    response:float32, compression:float32 = 11.0) Profile {
    // A square cylinder is a neutral geometric starting point; displacement is
    // explicit and the chamber follows compression instead of limiting capacity.
    let bore = Math.pow(litres * 4_000_000.0 / (Math.pi<float32>() * cylinders as float32), 1.0 / 3.0)
    var parts = EngineParts.Assembly(block:EngineParts.Block(cylinders:cylinders, bore_mm:bore, stroke_mm:bore),
        head:EngineParts.Head(chamber_cc:litres * 1_000.0 / (cylinders as float32 * (compression - 1.0)), sharpness:0.4))
    parts.mechanics = EngineParts.Mechanics(block_mass_kg:25.0 + litres * 35.0, clatter:0.12, whine:0.08)
    return Profile(id:id, name:name, parts:parts, idle_rpm:idle, redline_rpm:redline, response_seconds:response)
}

func city(cylinders:int, diesel:bool) Profile {
    var result = motor("city-i4", "City petrol I4", cylinders, 1.4, 800.0, 6_500.0, 0.45)
    if cylinders == 3 { result = motor("city-i3", "City petrol I3", 3, 1.0, 850.0, 6_500.0, 0.4) }
    result.parts.exhausts[0] = EngineParts.Exhaust(header:EngineParts.Pipe(length_mm:400.0, diameter_mm:32.0),
        pipe:EngineParts.Pipe(length_mm:2_100.0, diameter_mm:42.0),
        silencer:EngineParts.Silencer(volume_litres:10.0, absorption:0.85, baffles:4))
    result.parts.intake.filter_absorption = 0.85
    result.parts.mix = EngineParts.Mix(exhaust:0.65, intake:0.12, mechanics:0.24, turbo:0.1)
    if diesel {
        result.id = "city-diesel"; result.name = "City turbo diesel I4"
        result.parts.block.bore_mm = 80.0; result.parts.block.stroke_mm = 79.58
        result.parts.head = EngineParts.Head(chamber_cc:25.0, burn_ms:0.5, ignition:EngineParts.Ignition.compression, sharpness:0.85)
        result.parts.mechanics.clatter = 0.85; result.parts.mechanics.damping = 0.45
        result.parts.turbo = EngineParts.Turbo(wheel_mm:38.0, max_boost_bar:1.0, spool_seconds:0.5)
        result.parts.mix.mechanics = 0.65
        result.redline_rpm = 4_800.0; result.response_seconds = 0.65; result.roughness = 0.45
    }
    return result
}

func sport(cylinders:int, litres:float32, id:str, name:str, redline:float32) Profile {
    var result = motor(id, name, cylinders, litres, 900.0, redline, 0.22)
    result.parts.head.sharpness = 0.75
    result.parts.head.burn_ms = 0.65
    result.parts.intake = EngineParts.Intake(runner:EngineParts.Pipe(length_mm:240.0, diameter_mm:52.0),
        airbox_litres:5.0, filter_absorption:0.25)
    result.parts.exhausts = [EngineParts.Exhaust(header:EngineParts.Pipe(length_mm:550.0, diameter_mm:45.0),
        pipe:EngineParts.Pipe(length_mm:1_200.0, diameter_mm:70.0),
        silencer:EngineParts.Silencer(volume_litres:5.0, absorption:0.2, baffles:1))]
    result.parts.mechanics.whine = 0.25
    result.parts.mix = EngineParts.Mix(exhaust:0.85, intake:0.45, mechanics:0.12, turbo:0.22)
    if cylinders >= 6 {
        var second = result.parts.exhausts[0]; second.header.length_mm = 620.0
        second.pipe.length_mm = 1_350.0; second.outlet_level = 0.55
        result.parts.exhausts.append(second)
        for i in 0...cylinders { result.parts.block.exhaust_banks.append(i % 2) }
    }
    return result
}

func cross(cc:int, two_stroke:bool) Profile {
    var cycle = "4t"; var rpm:float32 = 10_000.0; var idle:float32 = 1_700.0
    if two_stroke { cycle = "2t"; rpm = 10_500.0; idle = 1_600.0 }
    if cc == 125 { rpm = 12_000.0 }
    if cc == 500 { rpm = 8_500.0 }
    var result = motor("cross-$(cc)-$(cycle)", "Motocross $(cc) $(cycle)", 1, cc as float32 / 1_000.0, idle, rpm, 0.12)
    result.parts.head.burn_ms = 0.45; result.parts.head.sharpness = 0.9
    result.parts.intake = EngineParts.Intake(runner:EngineParts.Pipe(length_mm:140.0, diameter_mm:38.0),
        airbox_litres:1.5, filter_absorption:0.25)
    result.parts.exhausts = [EngineParts.Exhaust(header:EngineParts.Pipe(length_mm:350.0, diameter_mm:34.0),
        pipe:EngineParts.Pipe(length_mm:650.0, diameter_mm:45.0),
        silencer:EngineParts.Silencer(volume_litres:1.2, absorption:0.2))]
    result.parts.mechanics = EngineParts.Mechanics(block_mass_kg:18.0 + cc as float32 * 0.02,
        damping:0.3, clatter:0.35, whine:0.18)
    result.parts.mix = EngineParts.Mix(exhaust:0.9, intake:0.32, mechanics:0.18, turbo:0.0)
    result.roughness = 0.55
    if two_stroke {
        result.parts.block.cycle = EngineParts.Cycle.two_stroke
        result.parts.head.chamber_cc = cc as float32 / 7.0
        result.parts.exhausts[0].expansion_litres = 1.0 + cc as float32 * 0.006
        result.parts.exhausts[0].pipe.length_mm = 800.0 + cc as float32 * 0.4
        result.parts.exhausts[0].silencer.volume_litres = 0.6
        result.parts.mechanics.clatter = 0.18
    }
    return result
}

func race(v4:bool) Profile {
    var result = sport(4, 1.0, "race-i4", "Race motorcycle I4", 15_000.0)
    result.idle_rpm = 1_500.0; result.response_seconds = 0.1
    result.parts.exhausts[0].pipe.length_mm = 650.0
    result.parts.exhausts[0].silencer = EngineParts.Silencer(volume_litres:1.8, absorption:0.12)
    result.parts.mechanics = EngineParts.Mechanics(block_mass_kg:65.0, damping:0.35, clatter:0.2, whine:0.65)
    result.parts.mix.intake = 0.6; result.parts.mix.mechanics = 0.2
    if v4 {
        result.id = "race-v4"; result.name = "Race motorcycle V4"
        result.parts.block.firing_angles = [0.0, 90.0, 360.0, 450.0]
        result.redline_rpm = 14_000.0; result.roughness = 0.35
    }
    return result
}

func custom(litres:float32) Profile {
    var result = motor("custom-1200", "Custom V-twin 1200", 2, litres, 850.0, 5_500.0, 0.55, compression:9.0)
    result.parts.block.firing_angles = [0.0, 315.0]
    result.parts.head.burn_ms = 1.1; result.parts.head.sharpness = 0.6
    result.parts.exhausts[0] = EngineParts.Exhaust(header:EngineParts.Pipe(length_mm:700.0, diameter_mm:42.0),
        pipe:EngineParts.Pipe(length_mm:1_000.0, diameter_mm:50.0),
        silencer:EngineParts.Silencer(volume_litres:2.0, absorption:0.18))
    result.parts.mechanics = EngineParts.Mechanics(block_mass_kg:90.0, damping:0.35, clatter:0.5, whine:0.05)
    result.parts.mix = EngineParts.Mix(exhaust:0.9, intake:0.25, mechanics:0.25, turbo:0.0)
    result.roughness = 0.8
    if litres > 1.5 {
        result.id = "custom-1800"; result.name = "Custom V-twin 1800"
        result.idle_rpm = 750.0; result.redline_rpm = 5_000.0; result.response_seconds = 0.7
        result.parts.exhausts[0].pipe.length_mm = 1_300.0
    }
    return result
}

public func catalogue() Profile[] {
    var turbo = sport(4, 2.0, "sport-turbo-i4", "Sport turbo I4", 7_000.0)
    turbo.parts.turbo = EngineParts.Turbo(wheel_mm:52.0, spool_seconds:0.3)
    var boxer = sport(6, 3.2, "sport-flat6", "Sport flat-six", 8_000.0)
    boxer.parts.block.exhaust_banks = [0, 0, 0, 1, 1, 1]
    boxer.parts.block.firing_order = [1, 4, 2, 5, 3, 6]
    var v8 = sport(8, 5.0, "sport-v8", "Sport cross-plane V8", 7_000.0)
    v8.parts.block.firing_order = [1, 8, 4, 3, 6, 5, 7, 2]
    v8.parts.exhausts[1].outlet_level = 0.25; v8.roughness = 0.4
    return [city(3, false), city(4, false), city(4, true), turbo, boxer, v8,
        sport(10, 5.2, "sport-v10", "Sport V10", 8_500.0),
        sport(12, 6.0, "sport-v12", "Sport V12", 9_000.0),
        cross(125, true), cross(250, true), cross(500, true), cross(250, false), cross(500, false),
        race(false), race(true), custom(1.2), custom(1.8)]
}
