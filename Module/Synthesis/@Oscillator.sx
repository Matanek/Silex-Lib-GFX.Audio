use GFX.Audio.Processing
use STD.Error
use STD.Math

public enum Waveform { sine; triangle; square; sawtooth }

public class Oscillator:Generator {
    let waveform:Waveform
    let duty_cycle:float32
    private var sine_coefficients:float32[]
    private var cosine_coefficients:float32[]
    private var dc:float32
    let format:Processing.Format
    private let initial_phase:float32
    private var phase:float32
    private var step:float32
    private var amplitude:float32

    private init(format:Processing.Format, step:float32, amplitude:float32, phase:float32, waveform:Waveform, duty_cycle:float32) {
        self.waveform = waveform
        self.duty_cycle = duty_cycle
        self.sine_coefficients = []
        self.cosine_coefficients = []
        self.dc = 0.0
        self.format = format
        self.initial_phase = phase
        self.phase = phase
        self.step = step
        self.amplitude = amplitude
        self.prepare_harmonics()
    }

    static func create(format:Processing.Format, frequency_hz:float32 = 440.0, amplitude:float32 = 1.0, phase:float32 = 0.0, waveform:Waveform = Waveform.sine, duty_cycle:float32 = 0.5) Result<Oscillator, Error> {
        if !Math.is_finite(duty_cycle) || duty_cycle <= 0.0 || duty_cycle >= 1.0 {
            return Result<Oscillator, Error>.failure(invalid("duty cycle must be finite and strictly between zero and one"))
        }
        if !valid_format(format) || !Math.is_finite(frequency_hz) || frequency_hz < 0.0 || !Math.is_finite(amplitude) || amplitude < 0.0 || amplitude > 1.0 || !Math.is_finite(phase) || phase < 0.0 || phase >= 1.0 {
            return Result<Oscillator, Error>.failure(invalid("invalid format, frequency, unit amplitude or phase in [0, 1)"))
        }
        let rate = format.sample_rate as float32
        let step = frequency_hz / rate
        if frequency_hz >= rate / 2.0 || (frequency_hz > 0.0 && step == 0.0) {
            return Result<Oscillator, Error>.failure(invalid("frequency must be representable and below Nyquist"))
        }
        return Result<Oscillator, Error>.success(Oscillator(format, step, amplitude, phase, waveform, duty_cycle))
    }

    func set_frequency(frequency_hz:float32) Result<void, Error> {
        let rate = self.format.sample_rate as float32
        let step = frequency_hz / rate
        if !Math.is_finite(frequency_hz) || frequency_hz < 0.0 || frequency_hz >= rate / 2.0 || (frequency_hz > 0.0 && step == 0.0) {
            return Result<void, Error>.failure(invalid("frequency must be finite, nonnegative, representable and below Nyquist"))
        }
        self.step = step
        self.prepare_harmonics()
        return Result<void, Error>.success()
    }

    func set_amplitude(amplitude:float32) Result<void, Error> {
        if !Math.is_finite(amplitude) || amplitude < 0.0 || amplitude > 1.0 {
            return Result<void, Error>.failure(invalid("amplitude must be finite and between zero and one"))
        }
        self.amplitude = amplitude
        return Result<void, Error>.success()
    }

    private func prepare_harmonics() {
        self.sine_coefficients.clear()
        self.cosine_coefficients.clear()
        self.dc = 0.0
        match self.waveform { sine => { return }; else => {} }
        var count = 0
        while count < 64 && (count + 1) as float32 * self.step < 0.5 { count++ }
        var harmonic = 1
        while harmonic <= count {
            let k = harmonic as float32
            let weight = 1.0 - k / (count + 1) as float32
            var sine:float32 = 0.0
            var cosine:float32 = 0.0
            match self.waveform {
                triangle => {
                    if harmonic % 2 == 1 {
                        var sign:float32 = 1.0
                        if harmonic % 4 == 3 { sign = -1.0 }
                        sine = sign * 8.0 / (Math.pi() * Math.pi() * k * k) * weight
                    }
                }
                sawtooth => { sine = -2.0 / (Math.pi() * k) * weight }
                square => {
                    let angle = Math.pi() * k * self.duty_cycle
                    let coefficient = 4.0 * Math.sin(angle) / (Math.pi() * k) * weight
                    sine = coefficient * Math.sin(angle)
                    cosine = coefficient * Math.cos(angle)
                    self.dc = 2.0 * self.duty_cycle - 1.0
                }
                else => {}
            }
            self.sine_coefficients.append(sine)
            self.cosine_coefficients.append(cosine)
            harmonic++
        }
    }

    private func value() float32 {
        let angle = 2.0 * Math.pi() * self.phase
        match self.waveform { sine => { return Math.sin(angle) }; else => {} }
        var value = self.dc
        var index = 0
        while index < self.sine_coefficients.count() {
            let harmonic_angle = (index + 1) as float32 * angle
            let sine = self.sine_coefficients[index]
            let cosine = self.cosine_coefficients[index]
            if sine != 0.0 { value += sine * Math.sin(harmonic_angle) }
            if cosine != 0.0 { value += cosine * Math.cos(harmonic_angle) }
            index++
        }
        // Fejer means preserve the unit range analytically; reserve rounding headroom.
        return value * 0.99999
    }

    func render(samples:&float32[..]) Result<void, Error> {
        try validate_block(@samples[0:samples.count()], self.format.channels) else error { return Result<void,Error>.failure(error) }
        var index = 0
        while index < samples.count() {
            let value = self.amplitude * self.value()
            var channel = 0
            while channel < self.format.channels { samples[index + channel] = value; channel++ }
            self.phase += self.step
            if self.phase >= 1.0 { self.phase -= 1.0 }
            index += self.format.channels
        }
        return Result<void, Error>.success()
    }

    func reset() { self.phase = self.initial_phase }
}
