use GFX.Audio.Processing
use STD.Error
use STD.Math

// Bounded modal strings: a pluck loses energy, a bow maintains its spectrum.
// Coefficients are prepared on note-on; phase/envelope state advances per frame.
class StringVoice:InstrumentVoice {
    var id:int = -1
    var order:int = 0
    var held:bool = false
    var frequency:float32 = 0.0
    private let rate:float32
    private let bowed:bool
    private let brightness:float32
    private let pluck_position:float32
    private let attack_frames:int
    private let decay_frames:int
    private let release_frames:int
    private let fade_frames:int
    private let vibrato_depth:float32
    private let vibrato_step:float32
    private let noise_filter:float32
    private var phases:float32[] = []
    private var levels:float32[] = []
    private var decays:float32[] = []
    private var active:bool = false
    private var age:int = 0
    private var lifetime:int = 0
    private var release_left:int = -1
    private var vibrato_phase:float32 = 0.0
    private var bow_level:float32 = 0.0
    private var noise:int = 1
    private var filtered:float32 = 0.0
    private var last:float32 = 0.0
    private var tail:float32 = 0.0
    private var fading:int = 0
    init(format:Processing.Format, bowed:bool, brightness:float32, pluck_position:float32, attack_frames:int, decay_frames:int, release_frames:int, fade_frames:int, vibrato_cents:float32, vibrato_hz:float32) {
        self.rate = format.sample_rate as float32; self.bowed = bowed; self.brightness = brightness
        self.pluck_position = pluck_position; self.attack_frames = attack_frames
        self.decay_frames = decay_frames; self.release_frames = release_frames; self.fade_frames = fade_frames
        self.vibrato_depth = vibrato_cents / 1200.0 * 0.6931471805599453
        self.vibrato_step = vibrato_hz / self.rate
        self.noise_filter = 1.0 - Math.exp(-6.283185307179586 as float32 * Math.min(2_000.0 as float32, self.rate * 0.2) / self.rate)
        var i = 0; while i < 32 { self.phases.append(0.0); self.levels.append(0.0); self.decays.append(0.0); i++ }
    }
    func occupied() bool { return self.active || self.fading > 0 }
    func start(id:int, frequency:float32, velocity:float32, order:int) {
        let replacing = self.occupied(); self.tail = 0.0; self.fading = 0
        if replacing && self.fade_frames > 0 { self.tail = self.last; self.fading = self.fade_frames }
        self.id = id; self.order = order; self.frequency = frequency; self.held = true
        self.active = true; self.age = 0; self.release_left = -1; self.noise = 1; self.filtered = 0.0; self.vibrato_phase = 0.0
        let loudness = velocity * (0.4 + 0.6 * velocity)
        let bright = self.brightness * (0.35 + 0.65 * velocity)
        let duration = self.decay_frames as float32 * Math.clamp(Math.pow(220.0 as float32 / frequency, 0.25), 0.5, 1.5)
        self.lifetime = Math.ceil(duration * (4.0 / 3.0)) as int
        self.bow_level = 0.0; if self.bowed { self.bow_level = loudness * 0.015 * bright }
        var total:float32 = 0.0; var i = 0
        while i < 32 {
            let n = (i + 1) as float32; let hz = frequency * n
            self.phases[i] = 0.0
            if self.bowed {
                let body = 0.4 + Math.exp(-Math.pow((hz - 600.0) / 350.0, 2.0)) + 0.7 * Math.exp(-Math.pow((hz - 1_500.0) / 650.0, 2.0)) + 0.4 * Math.exp(-Math.pow((hz - 2_500.0) / 900.0, 2.0))
                self.levels[i] = (body / n * Math.exp(-(n - 1.0) * (0.035 + 0.22 * (1.0 - bright)))) as float32
            } else {
                // A triangular displacement puts pluck-position nodes in the spectrum.
                self.levels[i] = (Math.sin(n * Math.pi<float32>() * self.pluck_position) / (n * n) * Math.exp(-(n - 1.0) * 0.35 * (1.0 - bright))) as float32
            }
            total += Math.abs(self.levels[i])
            self.decays[i] = Math.exp(-6.907755278982137 as float32 * (1.0 + (0.06 + 0.12 * (1.0 - bright)) * (n - 1.0)) / duration)
            i++
        }
        i = 0; while i < 32 { self.levels[i] *= (loudness - self.bow_level) / total; i++ }
    }
    func release() {
        if !self.active || self.release_left >= 0 { return }
        self.release_left = self.release_frames
        if self.release_frames == 0 { self.active = false }
    }
    func render(samples:&float32[..], ratios:@float32[..]) Result<void, Error> {
        var i = 0
        while i < samples.count() {
            var value:float32 = 0.0
            if self.active {
                var vibrato:float32 = 1.0
                if self.bowed && self.vibrato_depth > 0.0 {
                    vibrato += self.vibrato_depth * Math.sin(self.vibrato_phase * 6.283185307179586) as float32
                    self.vibrato_phase += self.vibrato_step; self.vibrato_phase -= Math.floor(self.vibrato_phase)
                }
                let step = self.frequency * ratios[i] * vibrato / self.rate
                var partial = 0
                while partial < 32 {
                    let increment = step * (partial + 1) as float32
                    let band = Math.clamp((0.5 - increment) / 0.05, 0.0, 1.0) as float32
                    if band > 0.0 { value += self.levels[partial] * band * Math.sin(self.phases[partial] * 6.283185307179586) as float32 }
                    self.phases[partial] += increment; self.phases[partial] -= Math.floor(self.phases[partial])
                    if !self.bowed { self.levels[partial] *= self.decays[partial] }
                    partial++
                }
                if self.bowed && self.bow_level > 0.0 {
                    self.noise = (self.noise * 48_271) % 2_147_483_647
                    let noise = 2.0 * ((self.noise % 16_777_216) as float32 / 16_777_216.0) - 1.0
                    self.filtered += self.noise_filter * (noise - self.filtered)
                    value += self.bow_level * (noise - self.filtered) * 0.5
                }
                if self.age < self.attack_frames { value *= self.age as float32 / self.attack_frames as float32 }
                if self.release_left >= 0 {
                    value *= self.release_left as float32 / self.release_frames as float32
                    self.release_left--; if self.release_left == 0 { self.active = false }
                }
                if self.bowed { if self.age < self.attack_frames { self.age++ } }
                else { self.age++; if self.age >= self.lifetime { self.active = false } }
            }
            if self.fading > 0 {
                let weight = self.fading as float32 / self.fade_frames as float32
                value = weight * self.tail + (1.0 - weight) * value; self.fading--
            }
            samples[i] = value; self.last = value; i++
        }
        return Result<void, Error>.success()
    }
    func reset() {
        self.active = false; self.fading = 0; self.id = -1; self.order = 0; self.held = false
        self.age = 0; self.release_left = -1; self.last = 0.0; self.tail = 0.0
    }
}
