use STD.Error
use STD.Error.Kind
use STD.Math

public enum Cycle { four_stroke; two_stroke }

public struct Block {
    var cylinders:int = 1
    var bore_mm:float32 = 86.0
    var stroke_mm:float32 = 86.0
    var cycle:Cycle = Cycle.four_stroke
    var firing_order:int[] = []
    var firing_angles:float32[] = []
    var exhaust_banks:int[] = []
    func displacement_litres() float32 {
        return self.cylinders as float32 * Math.pi<float32>() * self.bore_mm * self.bore_mm * self.stroke_mm / 4_000_000.0
    }
}
public struct Head {
    var chamber_cc:float32 = 55.0
    var burn_ms:float32 = 1.2
}
public struct Pipe {
    var length_mm:float32 = 800.0
    var diameter_mm:float32 = 50.0
}
public struct Silencer {
    var volume_litres:float32 = 8.0
    var absorption:float32 = 0.65
}
public struct Exhaust {
    var header:Pipe = Pipe(length_mm:600.0, diameter_mm:40.0)
    var pipe:Pipe = Pipe()
    var silencer:Silencer = Silencer()
    var outlet_level:float32 = 1.0
}
public struct Intake {
    var runner:Pipe = Pipe(length_mm:300.0, diameter_mm:40.0)
    var airbox_litres:float32 = 6.0
    var filter_absorption:float32 = 0.65
}
public struct Mechanics {
    var block_mass_kg:float32 = 100.0
    var damping:float32 = 0.65
}
public struct Turbo {
    var wheel_mm:float32 = 50.0
    var blade_count:int = 6
    var max_boost_bar:float32 = 1.5
    var spool_seconds:float32 = 0.35
}
public struct Mix {
    var exhaust:float32 = 0.8
    var intake:float32 = 0.25
    var mechanics:float32 = 0.08
    var turbo:float32 = 0.2
}
public struct Assembly {
    var block:Block = Block()
    var head:Head = Head()
    var intake:Intake = Intake()
    var exhausts:Exhaust[] = [Exhaust()]
    var mechanics:Mechanics = Mechanics()
    var turbo:Turbo? = null
    var mix:Mix = Mix()

    func compression_ratio() float32 {
        return 1.0 + self.block.displacement_litres() * 1_000.0 / (self.block.cylinders as float32 * self.head.chamber_cc)
    }
    func validate() Result<void, Error> {
        if self.block.cylinders < 1 || self.block.cylinders > 16 || !in_range(self.block.bore_mm, 20.0, 200.0) ||
            !in_range(self.block.stroke_mm, 20.0, 250.0) || !in_range(self.head.chamber_cc, 1.0, 500.0) ||
            !in_range(self.head.burn_ms, 0.1, 8.0) || !in_range(self.compression_ratio(), 2.0, 25.0) ||
            self.exhausts.count() < 1 || self.exhausts.count() > 4 {
            return Result<void, Error>.failure(invalid("invalid block, head, compression ratio or exhaust count"))
        }
        if !pipe_valid(self.intake.runner) || !in_range(self.intake.airbox_litres, 0.05, 100.0) ||
            !unit(self.intake.filter_absorption) || !in_range(self.mechanics.block_mass_kg, 1.0, 2_000.0) || !unit(self.mechanics.damping) || !mix_valid(self.mix) {
            return Result<void, Error>.failure(invalid("invalid intake, mechanics or mix"))
        }
        for exhaust in self.exhausts {
            if !pipe_valid(exhaust.header) || !pipe_valid(exhaust.pipe) ||
                !in_range(exhaust.silencer.volume_litres, 0.05, 100.0) || !unit(exhaust.silencer.absorption) || !unit(exhaust.outlet_level) {
                return Result<void, Error>.failure(invalid("invalid exhaust pipe or silencer"))
            }
        }
        if let value = self.turbo {
            if !in_range(value.wheel_mm, 20.0, 150.0) || value.blade_count < 2 || value.blade_count > 16 ||
                !in_range(value.max_boost_bar, 0.1, 4.0) || !in_range(value.spool_seconds, 0.01, 5.0) {
                return Result<void, Error>.failure(invalid("invalid turbo wheel, blades, pressure or inertia"))
            }
        }
        let count = self.block.cylinders
        if (self.block.firing_order.count() != 0 && self.block.firing_order.count() != count) ||
            (self.block.firing_angles.count() != 0 && self.block.firing_angles.count() != count) ||
            (self.block.exhaust_banks.count() != 0 && self.block.exhaust_banks.count() != count) {
            return Result<void, Error>.failure(invalid("one firing order, angle and bank entry per cylinder is required"))
        }
        var cycle_degrees:float32 = 720.0
        if self.block.cycle == Cycle.two_stroke { cycle_degrees = 360.0 }
        for i in 0...count {
            if self.block.firing_order.count() != 0 {
                let cylinder = self.block.firing_order[i]
                if cylinder < 1 || cylinder > count { return Result<void, Error>.failure(invalid("firing order must be a cylinder permutation")) }
                for previous in 0...i {
                    if self.block.firing_order[previous] == cylinder { return Result<void, Error>.failure(invalid("duplicate firing cylinder")) }
                }
            }
            if self.block.firing_angles.count() != 0 {
                let angle = self.block.firing_angles[i]
                if !in_range(angle, 0.0, cycle_degrees - 0.001) || (i == 0 && angle != 0.0) {
                    return Result<void, Error>.failure(invalid("firing angles start at zero and remain inside the cycle"))
                }
                if i > 0 && angle <= self.block.firing_angles[i - 1] { return Result<void, Error>.failure(invalid("firing angles must increase")) }
            }
            if self.block.exhaust_banks.count() != 0 && (self.block.exhaust_banks[i] < 0 || self.block.exhaust_banks[i] >= self.exhausts.count()) {
                return Result<void, Error>.failure(invalid("cylinder references an absent exhaust"))
            }
        }
        return Result<void, Error>.success()
    }
}
func in_range(value:float32, low:float32, high:float32) bool { return Math.is_finite(value) && value >= low && value <= high }
func unit(value:float32) bool { return in_range(value, 0.0, 1.0) }
func pipe_valid(value:Pipe) bool { return in_range(value.length_mm, 20.0, 5_000.0) && in_range(value.diameter_mm, 5.0, 250.0) }
package func mix_valid(value:Mix) bool { return unit(value.exhaust) && unit(value.intake) && unit(value.mechanics) && unit(value.turbo) }
func invalid(detail:str) Error { return Error(kind:Kind.invalid_input(), operation:"audio.engine-parts", subject:null, detail:detail) }

public func v8() Assembly {
    let exhaust = Exhaust(header:Pipe(length_mm:700.0, diameter_mm:45.0),
        pipe:Pipe(length_mm:1_800.0, diameter_mm:65.0), silencer:Silencer(volume_litres:14.0, absorption:0.7))
    var second = exhaust
    second.header.length_mm = 760.0; second.pipe.length_mm = 1_950.0; second.outlet_level = 0.1
    return Assembly(block:Block(cylinders:8, bore_mm:108.0, stroke_mm:101.6,
        firing_order:[1, 8, 4, 3, 6, 5, 7, 2], exhaust_banks:[0, 1, 0, 1, 0, 1, 0, 1]),
        head:Head(chamber_cc:100.0, burn_ms:1.8), exhausts:[exhaust, second],
        intake:Intake(runner:Pipe(length_mm:420.0, diameter_mm:48.0), airbox_litres:12.0),
        mechanics:Mechanics(block_mass_kg:230.0))
}
public func motocross(cycle:Cycle = Cycle.four_stroke) Assembly {
    var result = Assembly(block:Block(bore_mm:96.0, stroke_mm:62.1), head:Head(chamber_cc:40.0, burn_ms:0.9),
        intake:Intake(runner:Pipe(length_mm:180.0, diameter_mm:43.0), airbox_litres:2.0, filter_absorption:0.35),
        exhausts:[Exhaust(header:Pipe(length_mm:450.0, diameter_mm:38.0), pipe:Pipe(length_mm:600.0, diameter_mm:50.0),
            silencer:Silencer(volume_litres:3.0, absorption:0.35))], mechanics:Mechanics(block_mass_kg:30.0))
    if cycle == Cycle.two_stroke {
        result.block = Block(bore_mm:66.4, stroke_mm:72.0, cycle:Cycle.two_stroke)
        result.head = Head(chamber_cc:35.0, burn_ms:0.7)
        result.exhausts[0].pipe = Pipe(length_mm:900.0, diameter_mm:90.0)
    }
    return result
}
