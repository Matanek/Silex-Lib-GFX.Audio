use GFX.Audio.Processing
use GFX.Audio.Synthesis.EngineParts
use STD.Error
use STD.Math

public class Engine:Generator {
    let format:Processing.Format
    let seed:int
    let cylinders:int { get {
        if var model = self.model { return model.parts.block.cylinders }
        if var classic = self.classic { return classic.cylinders }
        return 0
    } }
    private var classic:ClassicEngine? = null
    private var model:EngineModel? = null
    private var previous:EngineModel? = null
    private var pending:EngineModel? = null
    private let amplitude:float32
    private var fade:int = 0
    private var fade_frames:int = 0
    private var pending_frames:int = 0
    private var old_samples:float32[]
    private var new_samples:float32[]

    private init(format:Processing.Format, seed:int, amplitude:float32) {
        self.format = format; self.seed = seed; self.amplitude = amplitude
        self.old_samples = scratch(480 * format.channels); self.new_samples = scratch(480 * format.channels)
    }
    static func create(format:Processing.Format = Processing.Format(sample_rate:48_000, channels:2),
        cylinders:int = 8, seed:int = 42, amplitude:float32 = 0.4) Result<Engine, Error> {
        var classic = try ClassicEngine.create(format, cylinders, seed, amplitude) else error { return Result<Engine, Error>.failure(error) }
        var result = Engine(format, seed, amplitude); result.classic = classic
        return Result<Engine, Error>.success(result)
    }
    static func assemble(parts:EngineParts.Assembly,
        format:Processing.Format = Processing.Format(sample_rate:48_000, channels:2),
        seed:int = 42, amplitude:float32 = 0.4) Result<Engine, Error> {
        try parts.validate() else error { return Result<Engine, Error>.failure(error) }
        if format.sample_rate < 22_050 || format.sample_rate > 192_000 || (format.channels != 1 && format.channels != 2) ||
            !Engine.unit(amplitude) { return Result<Engine, Error>.failure(invalid("engine requires 22050..192000 Hz, mono/stereo and unit amplitude")) }
        var result = Engine(format, seed, amplitude)
        result.model = EngineModel(parts, format, seed, amplitude)
        return Result<Engine, Error>.success(result)
    }
    func parts() EngineParts.Assembly? {
        if var pending = self.pending { return pending.parts }
        if var model = self.model { return model.parts }
        return null
    }
    func set_parts(parts:EngineParts.Assembly, transition_frames:int = 2_400) Result<void, Error> {
        try parts.validate() else error { return Result<void, Error>.failure(error) }
        if !valid_ramp(transition_frames) { return Result<void, Error>.failure(invalid("invalid engine transition duration")) }
        if var model = self.model {
            var next = EngineModel(parts, self.format, self.seed, self.amplitude)
            if self.previous != null {
                self.pending = next; self.pending_frames = transition_frames
            } else {
                next.inherit(model); self.model = next
                if transition_frames > 0 { self.previous = model; self.fade = 0; self.fade_frames = transition_frames }
            }
            return Result<void, Error>.success()
        }
        return Result<void, Error>.failure(invalid("create the engine with parts before replacing its assembly"))
    }
    func set_state(rpm:float32, throttle:float32 = 0.0, load:float32 = 0.0,
        engine_brake:float32 = 0.0, ramp_frames:int = 480, fuel:float32 = 1.0, boost:float32 = 0.0) Result<void, Error> {
        if !Math.is_finite(rpm) || rpm < 0.0 || rpm > 20_000.0 || !Engine.unit(throttle) || !Engine.unit(load) || !Engine.unit(engine_brake) ||
            !Engine.unit(fuel) || !Engine.unit(boost) || !valid_ramp(ramp_frames) {
            return Result<void, Error>.failure(invalid("engine requires finite rpm in [0,20000], unit controls and a supported ramp"))
        }
        if var model = self.model {
            model.state(rpm, throttle, load, engine_brake, fuel, boost, ramp_frames)
            if var previous = self.previous { previous.state(rpm, throttle, load, engine_brake, fuel, boost, ramp_frames) }
            return Result<void, Error>.success()
        }
        if var classic = self.classic { return try classic.set_state(rpm, throttle, load, engine_brake, ramp_frames, fuel) }
        return Result<void, Error>.success()
    }
    func set_character(exhaust:float32, roughness:float32, ramp_frames:int = 480) Result<void, Error> {
        if !Engine.unit(exhaust) || !Engine.unit(roughness) || !valid_ramp(ramp_frames) { return Result<void, Error>.failure(invalid("invalid engine character or ramp")) }
        if var model = self.model {
            model.character(exhaust, roughness, ramp_frames)
            if var previous = self.previous { previous.character(exhaust, roughness, ramp_frames) }
            return Result<void, Error>.success()
        }
        if var classic = self.classic { return try classic.set_character(exhaust, roughness, ramp_frames) }
        return Result<void, Error>.success()
    }
    func set_mix(mix:EngineParts.Mix, ramp_frames:int = 480) Result<void, Error> {
        if !EngineParts.mix_valid(mix) || !valid_ramp(ramp_frames) { return Result<void, Error>.failure(invalid("invalid engine mix or ramp")) }
        if var model = self.model {
            model.mix(mix, ramp_frames)
            if var previous = self.previous { previous.mix(mix, ramp_frames) }
            if var pending = self.pending { pending.mix(mix, ramp_frames) }
            return Result<void, Error>.success()
        }
        return Result<void, Error>.failure(invalid("mix requires an engine created with parts"))
    }
    func current_rpm() float32 {
        if var model = self.model { return model.current_rpm() }
        if var classic = self.classic { return classic.current_rpm() }
        return 0.0
    }
    private static func unit(value:float32) bool { return Math.is_finite(value) && value >= 0.0 && value <= 1.0 }
    func render(samples:&float32[..]) Result<void, Error> {
        try validate_block(@samples[0:samples.count()], self.format.channels) else error { return Result<void, Error>.failure(error) }
        if var classic = self.classic { return try classic.render(&samples[0:samples.count()]) }
        var offset = 0
        while offset < samples.count() {
            if var model = self.model {
                if var previous = self.previous {
                    var frames = (samples.count() - offset) / self.format.channels
                    if frames > 480 { frames = 480 }
                    if frames > self.fade_frames - self.fade { frames = self.fade_frames - self.fade }
                    let count = frames * self.format.channels
                    try previous.render(&self.old_samples[0:count]) else error { return Result<void, Error>.failure(error) }
                    try model.render(&self.new_samples[0:count]) else error { return Result<void, Error>.failure(error) }
                    for frame in 0...frames {
                        let blend = (self.fade + frame) as float32 / self.fade_frames as float32
                        for channel in 0...self.format.channels {
                            let i = frame * self.format.channels + channel
                            samples[offset + i] = (1.0 - blend) * self.old_samples[i] + blend * self.new_samples[i]
                        }
                    }
                    self.fade += frames; offset += count
                    if self.fade == self.fade_frames {
                        self.previous = null
                        if var pending = self.pending {
                            pending.inherit(model); self.model = pending; self.pending = null
                            self.fade = 0; self.fade_frames = self.pending_frames
                            if self.fade_frames > 0 { self.previous = model }
                        }
                    }
                } else {
                    try model.render(&samples[offset:samples.count()]) else error { return Result<void, Error>.failure(error) }
                    offset = samples.count()
                }
            }
        }
        return Result<void, Error>.success()
    }
    func reset() {
        if var classic = self.classic { classic.reset() }
        if var pending = self.pending { self.model = pending }
        if var model = self.model { model.reset() }
        self.previous = null; self.pending = null; self.fade = 0; self.fade_frames = 0
    }
}
