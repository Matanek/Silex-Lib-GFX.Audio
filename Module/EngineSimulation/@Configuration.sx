use GFX.Audio.Synthesis.EngineParts
use STD.Math

public struct Cylinder {
    var bore_mm:float32 = 86.0
    var stroke_mm:float32 = 86.0
    var rod_mm:float32 = 143.0
    var piston_kg:float32 = 0.38
    var chamber_cc:float32 = 55.0
    var friction:float32 = 0.08
    var firing_degrees:float32 = 0.0
    var exhaust_index:int = 0

    module func swept_cc() float32 {
        return Math.pi<float32>() * self.bore_mm * self.bore_mm * self.stroke_mm / 4_000.0
    }
}

public struct Assembly {
    var cylinders:Cylinder[] = [Cylinder()]
    var inertia_kg_m2:float32 = 0.23
    var starter_nm:float32 = 75.0
    var exhausts:EngineParts.Exhaust[] = []
}

public struct Controls {
    var starter:bool = false
    var ignition:bool = false
    var throttle:float32 = 0.0
    var load_nm:float32 = 0.0
    var hold_rpm:float32? = null
}
