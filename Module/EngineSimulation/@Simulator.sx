use GFX.Audio.Processing
use GFX.Audio.Synthesis
use GFX.Audio.Synthesis.EngineResonance
use GFX.Audio.Synthesis.EnginePulse
use GFX.Audio.Synthesis.EngineExhaustPath
use GFX.Audio.Synthesis.EngineParts
use STD.Error
use STD.Error.Kind
use STD.Math

public struct Sources {
    let friction:float32 = 0.0
    let intake:float32 = 0.0
    let combustion:float32 = 0.0
    func mixed() float32 { return bounded(self.friction + self.intake + self.combustion) }
}

func maximum_rpm() float32 { return 24_000.0 }

public class Simulator:Synthesis.Generator {
    let format:Processing.Format = Processing.Format(sample_rate:48_000, channels:1)
    private var cylinders:CylinderMotion[] = []
    private var exhaust:ExhaustSystem
    private var incoming_exhaust:ExhaustSystem? = null
    private var queued_exhaust:ExhaustSystem? = null
    private let exhaust_fade_frames:int = 1_920
    private var exhaust_fade:int = 0
    private let cylinder_scale:float32
    private let inertia:float32
    private let starter_torque:float32
    private let rev_limit:float32
    private let rev_limit_cut_frames:int
    private var ignition_cut_until:int = 0
    private let drag_scale:float32
    private let intake_gain:float32
    private var control:Controls = Controls()
    private var shaft:float32 = 0.0
    private var angle:float64 = 0.0
    private var cylinders_at_rest:bool = true
    private var clock:int = 0
    private var random:int = 1_927
    private var sliding:EngineResonance
    private var block_low:EngineResonance
    private var block_high:EngineResonance
    private var plenum:EngineResonance
    private var runner:EngineResonance
    private var turbulence:EngineResonance
    private var intake_travel:float32[] = []
    private var intake_cursor:int = 0

    private init(assembly:Assembly) {
        self.inertia = assembly.inertia_kg_m2
        self.starter_torque = assembly.starter_nm
        self.rev_limit = assembly.rev_limit_rpm
        self.rev_limit_cut_frames = Math.round(assembly.rev_limit_cut_ms * 48.0) as int
        self.sliding = EngineResonance(48_000.0, 370.0, 0.8)
        self.block_low = EngineResonance(48_000.0, 900.0, 1.8)
        self.block_high = EngineResonance(48_000.0, 2_100.0, 1.3)
        self.turbulence = EngineResonance(48_000.0, 1_200.0, 0.65)
        var swept_cc:float32 = 0.0
        var outlets:int[] = []
        for index, cylinder in assembly.cylinders.indexed() {
            swept_cc += cylinder.swept_cc()
            var motion = CylinderMotion(cylinder, index)
            motion.reset()
            self.cylinders.append(motion)
            outlets.append(cylinder.exhaust_index)
        }
        self.drag_scale = Math.min(1.0, swept_cc / 499.0)
        // Generic intake dimensions. The plenum follows engine size and
        // the runner follows mean cylinder size.
        let cylinder_scale = Math.pow(swept_cc / assembly.cylinders.count() as float32 / 499.0, 1.0 / 3.0)
        self.cylinder_scale = cylinder_scale
        self.exhaust = ExhaustSystem(assembly.exhausts, outlets, cylinder_scale)
        let inlet_radius = 0.017 * Math.sqrt(swept_cc / 499.0 + 1.0)
        self.intake_gain = 16.0 * Math.min(1.0, 0.070 / inlet_radius)
        let plenum_volume = (650.0 + 0.50 * swept_cc) * 0.000001
        let neck_length = 0.15 * cylinder_scale
        let runner_length = 0.32 * cylinder_scale
        let air_speed:float32 = 343.0
        let plenum_hz = air_speed / (2.0 * Math.pi<float32>()) *
            Math.sqrt(Math.pi<float32>() * inlet_radius * inlet_radius / (plenum_volume * neck_length))
        self.plenum = EngineResonance(48_000.0, plenum_hz, 1.1)
        self.runner = EngineResonance(48_000.0, air_speed / (4.0 * runner_length), 1.5)
        // The runner, plenum and mouth add travel time before the sound radiates.
        let mouth_path = runner_length + 2.0 * neck_length
        let travel_frames = Math.round(mouth_path * 48_000.0 / air_speed) as int
        for _ in 0...travel_frames { self.intake_travel.append(0.0) }
    }

    static func create(assembly:Assembly = Assembly()) Result<Simulator, Error> {
        if assembly.cylinders.count() < 1 || assembly.cylinders.count() > 16 ||
            !in_range(assembly.inertia_kg_m2, 0.02, 10.0) || !in_range(assembly.starter_nm, 1.0, 2_500.0) {
            return Result<Simulator, Error>.failure(invalid("expected 1..16 cylinders, positive inertia and starter torque within range"))
        }
        if !exhausts_valid(assembly.exhausts) {
            return Result<Simulator, Error>.failure(invalid("expected at most four valid exhaust paths"))
        }
        if !in_range(assembly.rev_limit_rpm, 500.0, 20_000.0) || !in_range(assembly.rev_limit_cut_ms, 0.0, 2_000.0) {
            return Result<Simulator, Error>.failure(invalid("expected a rev limit of 500..20000 rpm and a cut of 0..2000 ms"))
        }
        let exhaust_count = Math.max(1, assembly.exhausts.count())
        for cylinder in assembly.cylinders {
            if !in_range(cylinder.bore_mm, 20.0, 200.0) || !in_range(cylinder.stroke_mm, 20.0, 200.0) ||
                !in_range(cylinder.rod_mm, cylinder.stroke_mm * 0.6, 400.0) || !in_range(cylinder.piston_kg, 0.05, 5.0) ||
                !in_range(cylinder.chamber_cc, 2.0, 500.0) || !in_range(cylinder.friction, 0.0, 0.5) ||
                !in_range(cylinder.firing_degrees, 0.0, 720.0) || cylinder.firing_degrees == 720.0 {
                return Result<Simulator, Error>.failure(invalid("invalid four-stroke cylinder geometry, mass, friction or firing phase"))
            }
            if !in_range(1.0 + cylinder.swept_cc() / cylinder.chamber_cc, 2.0, 25.0) {
                return Result<Simulator, Error>.failure(invalid("expected compression ratio in [2, 25]"))
            }
            if cylinder.exhaust_index < 0 || cylinder.exhaust_index >= exhaust_count {
                return Result<Simulator, Error>.failure(invalid("cylinder references an absent exhaust path"))
            }
        }
        return Result<Simulator, Error>.success(Simulator(assembly))
    }

    func set_controls(value:Controls) Result<void, Error> {
        if !in_range(value.throttle, 0.0, 1.0) || !in_range(value.load_nm, 0.0, 4_000.0) {
            return Result<void, Error>.failure(invalid("expected unit throttle and load in [0, 4000] N m"))
        }
        if let rpm = value.hold_rpm {
            if !in_range(rpm, 0.0, maximum_rpm()) {
                return Result<void, Error>.failure(invalid("expected held speed in [0, 24000] rpm"))
            }
        }
        self.control = value
        if !value.ignition { self.ignition_cut_until = 0 }
        return Result<void, Error>.success()
    }

    func set_exhaust(paths:EngineParts.Exhaust[], cylinder_outlets:int[]) Result<void, Error> {
        if !exhausts_valid(paths) || cylinder_outlets.count() != self.cylinders.count() {
            return Result<void, Error>.failure(invalid("expected at most four valid exhaust paths and one outlet per cylinder"))
        }
        let count = Math.max(1, paths.count())
        for outlet in cylinder_outlets {
            if outlet < 0 || outlet >= count {
                return Result<void, Error>.failure(invalid("cylinder references an absent exhaust path"))
            }
        }
        var requested = ExhaustSystem(paths, cylinder_outlets, self.cylinder_scale)
        if self.clock == 0 { self.exhaust = requested }
        elif self.incoming_exhaust == null { self.incoming_exhaust = requested }
        else { self.queued_exhaust = requested }
        return Result<void, Error>.success()
    }

    func rpm() float32 { return self.shaft * (60.0 / 6.28318530718) }
    func frame() int { return self.clock }
    func cylinder(index:int) CylinderState? {
        if index < 0 || index >= self.cylinders.count() { return null }
        return self.cylinders[index].snapshot()
    }

    func render(samples:&float32[..]) Result<void, Error> {
        for i in 0...samples.count() { samples[i] = self.next().mixed() }
        return Result<void, Error>.success()
    }

    func render_sources(frames:&Sources[..]) {
        for i in 0...frames.count() { frames[i] = self.next() }
    }

    func reset() {
        self.control = Controls()
        self.ignition_cut_until = 0
        self.shaft = 0.0
        self.angle = 0.0
        self.cylinders_at_rest = true
        self.clock = 0
        self.random = 1_927
        for i in 0...self.cylinders.count() { self.cylinders[i].reset() }
        self.sliding.reset()
        self.block_low.reset()
        self.block_high.reset()
        self.plenum.reset()
        self.runner.reset()
        self.turbulence.reset()
        for i in 0...self.intake_travel.count() { self.intake_travel[i] = 0.0 }
        self.intake_cursor = 0
        if var latest = self.queued_exhaust { self.exhaust = latest }
        elif var pending = self.incoming_exhaust { self.exhaust = pending }
        self.queued_exhaust = null
        self.incoming_exhaust = null
        self.exhaust_fade = 0
        self.exhaust.reset()
    }

    private func next() Sources {
        let held = self.control.hold_rpm
        if let rpm = held { self.shaft = rpm * (6.28318530718 / 60.0) }
        let speed = self.rpm()
        if self.control.ignition && speed >= self.rev_limit {
            self.ignition_cut_until = self.clock + self.rev_limit_cut_frames
        }
        let ignite = self.control.ignition && speed >= 140.0 && speed < self.rev_limit && self.clock >= self.ignition_cut_until
        var torque:float32 = 0.0
        var sliding:float32 = 0.0
        var impact:float32 = 0.0
        var intake:float32 = 0.0
        let moving = self.shaft > 0.0
        if moving {
            self.angle = cycle_position(self.angle + self.shaft as float64 / (6.28318530718 * 48_000.0))
        }
        // Refresh telemetry on the first stationary sample. With a fixed angle
        // and zero speed the cylinder excitations then stay at zero.
        if moving || !self.cylinders_at_rest {
            for i in 0...self.cylinders.count() {
                let source = self.cylinders[i].next(self.angle, self.shaft, self.control.throttle, ignite, self.clock)
                if moving { torque += source.torque_nm }
                sliding += source.sliding_n
                impact += source.impact_ns
                intake += source.intake_m3_s
                if source.release_pa > 0.0 {
                    self.exhaust.release(i, source.release_pa)
                    if var incoming = self.incoming_exhaust { incoming.release(i, source.release_pa) }
                }
            }
            self.cylinders_at_rest = !moving
        }
        if held == null {
            var starter:float32 = 0.0
            if self.control.starter { starter = self.starter_torque * Math.max(0.0, 1.0 - speed / 650.0) }
            let resistance = (2.2 + 0.018 * self.shaft) * self.drag_scale + self.control.load_nm
            self.shaft = Math.clamp(self.shaft + (starter + torque - resistance) / (self.inertia * 48_000.0),
                0.0, maximum_rpm() * (6.28318530718 / 60.0))
            if !self.control.starter && !self.control.ignition && self.rpm() < 15.0 { self.shaft = 0.0 }
        }
        self.clock += 1

        let rub = self.sliding.next(0.002 * sliding) +
            self.block_low.next(16.0 * impact) + self.block_high.next(5.5 * impact)
        // A closed throttle plate also attenuates pressure waves travelling to the inlet.
        let inlet_coupling = 0.35 + 0.65 * self.control.throttle
        let airflow = self.intake_gain * intake * inlet_coupling
        let air = self.intake_travel[self.intake_cursor]
        self.intake_travel[self.intake_cursor] = self.plenum.next(airflow) + 0.55 * self.runner.next(airflow) +
            self.turbulence.next(0.14 * airflow * self.noise())
        self.intake_cursor += 1
        if self.intake_cursor == self.intake_travel.count() { self.intake_cursor = 0 }
        return Sources(friction:bounded(rub), intake:bounded(air), combustion:bounded(self.exhaust_sample()))
    }

    private func exhaust_sample() float32 {
        let current = self.exhaust.next()
        if var incoming = self.incoming_exhaust {
            let target = incoming.next()
            self.exhaust_fade += 1
            if self.exhaust_fade == self.exhaust_fade_frames {
                self.exhaust = incoming
                self.incoming_exhaust = self.queued_exhaust
                self.queued_exhaust = null
                self.exhaust_fade = 0
                return target
            }
            let t = self.exhaust_fade as float32 / self.exhaust_fade_frames as float32
            return Math.mix(current, target, t * t * (3.0 - 2.0 * t))
        }
        return current
    }

    private func noise() float32 {
        self.random = (self.random * 48_271) % 2_147_483_647
        return (self.random % 16_777_216) as float32 / 8_388_608.0 - 1.0
    }
}

class ExhaustSystem {
    private let routing:int[]
    private var voices:ExhaustVoice[] = []

    init(paths:EngineParts.Exhaust[], routing:int[], cylinder_scale:float32) {
        self.routing = routing
        for path in paths { self.voices.append(ExhaustVoice(path, cylinder_scale)) }
        if self.voices.count() == 0 { self.voices.append(ExhaustVoice(null, cylinder_scale)) }
    }

    func release(cylinder:int, pressure:float32) { self.voices[self.routing[cylinder]].release(pressure) }

    func next() float32 {
        var sum:float32 = 0.0
        for i in 0...self.voices.count() { sum += self.voices[i].next() }
        return sum
    }

    func reset() {
        for i in 0...self.voices.count() { self.voices[i].reset() }
    }
}

class ExhaustVoice {
    private var released_pa:float32 = 0.0
    private var pulse:EnginePulse
    private var pipes:EngineExhaustPath? = null
    private var outlet:EngineResonance
    private var attack:EngineResonance

    init(parts:EngineParts.Exhaust?, cylinder_scale:float32) {
        // With the generic outlet, the resonant lengths scale with the cylinder.
        self.outlet = EngineResonance(48_000.0, 170.0 / cylinder_scale, 1.5)
        self.attack = EngineResonance(48_000.0, 1_050.0 / cylinder_scale, 0.85)
        if let exhaust = parts {
            self.pulse = EnginePulse(48_000.0, 3.5 * cylinder_scale, 0.85 + 0.17 * cylinder_scale)
            self.pipes = EngineExhaustPath(48_000.0, exhaust)
        } else {
            self.pulse = EnginePulse(48_000.0, 3.5 * cylinder_scale, 0.14 * cylinder_scale)
        }
    }

    func release(pressure_pa:float32) { self.released_pa += pressure_pa }

    func next() float32 {
        self.pulse.fire(self.released_pa * 0.0000048)
        self.released_pa = 0.0
        let pressure = self.pulse.next()
        if var pipes = self.pipes { return 0.37 * pipes.next(pressure) }
        return pressure + 0.52 * self.outlet.next(pressure) + 0.55 * self.attack.next(pressure)
    }

    func reset() {
        self.released_pa = 0.0
        self.pulse.reset()
        self.outlet.reset()
        self.attack.reset()
        if var pipes = self.pipes { pipes.reset() }
    }
}

func bounded(value:float32) float32 { return value / (1.0 + Math.abs(value)) }
func exhausts_valid(paths:EngineParts.Exhaust[]) bool {
    if paths.count() > 4 { return false }
    for path in paths {
        if !EngineParts.exhaust_valid(path) { return false }
    }
    return true
}
func in_range(value:float32, low:float32, high:float32) bool {
    return Math.is_finite(value) && value >= low && value <= high
}
func invalid(detail:str) Error {
    return Error(kind:Kind.invalid_input(), operation:"audio.engine-simulation", detail:detail)
}
