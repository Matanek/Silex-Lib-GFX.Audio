use STD.Math

public struct CylinderState {
    let cycle_degrees:float32 = 0.0
    let piston_mm:float32 = 0.0
    let piston_mps:float32 = 0.0
    let friction_n:float32 = 0.0
    let intake_m3_s:float32 = 0.0
    let pressure_pa:float32 = 101_325.0
    let firings:int = 0
    let last_firing_frame:int? = null
}

struct Excitation {
    let torque_nm:float32 = 0.0
    let sliding_n:float32 = 0.0
    let impact_ns:float32 = 0.0
    let intake_m3_s:float32 = 0.0
    let release_pa:float32 = 0.0
}

class CylinderMotion {
    private let offset:float64
    private let radius:float32
    private let radius_squared:float32
    private let rod:float32
    private let rod_squared:float32
    private let area:float32
    private let piston_mass:float32
    private let skirt_gap:float32
    private let lateral_step:float32
    private let clearance:float32
    private let trapped_volume:float32
    private let expansion_scale:float32
    private let exhaust_scale:float32
    private let flame_turns:float32
    private let vent_frames:float32
    private let friction:float32
    private let seed:int
    private var random:int
    private var phase:float64
    private var heat_pa:float32 = 0.0
    private var charge:float32 = 1.0
    private var burn_turns:float32 = 0.075
    private var combustion_pa:float32 = 0.0
    private var vent_pressure:float32 = 0.0
    private var vent_fraction:float32 = 0.0
    private var vent_left:int = 0
    private var lateral_position:float32 = 0.0
    private var lateral_speed:float32 = 0.0
    private var state:CylinderState = CylinderState()

    init(cylinder:Cylinder, index:int) {
        self.offset = cylinder.firing_degrees as float64 / 360.0
        self.radius = cylinder.stroke_mm * 0.0005
        self.radius_squared = self.radius * self.radius
        self.rod = cylinder.rod_mm * 0.001
        self.rod_squared = self.rod * self.rod
        self.area = Math.pi<float32>() * cylinder.bore_mm * cylinder.bore_mm * 0.00000025
        // Approximate radiation through an outlet whose area follows the bore.
        self.exhaust_scale = cylinder.bore_mm / 86.0
        // The flame crosses the bore. For similarly shaped ports, the
        // chamber-volume to valve-area ratio follows the cylinder length.
        self.flame_turns = Math.clamp(0.075 * self.exhaust_scale, 0.025, 0.17)
        self.vent_frames = 8.64 * Math.pow(cylinder.swept_cc() / 499.0, 1.0 / 3.0) // 0.18 ms at 499 cc.
        self.piston_mass = cylinder.piston_kg
        self.skirt_gap = cylinder.bore_mm * 0.00000035
        self.lateral_step = 1.0 / (48_000.0 * self.piston_mass)
        self.clearance = cylinder.chamber_cc * 0.000001
        self.trapped_volume = self.clearance + self.area * self.radius * 2.0
        self.expansion_scale = Math.pow(self.clearance / self.trapped_volume, 1.28)
        self.friction = cylinder.friction
        self.seed = 1_927 + index * 467
        self.random = self.seed
        self.phase = cycle_position(-self.offset)
    }

    func snapshot() CylinderState { return self.state }

    func next(turns:float64, omega:float32, throttle:float32, ignite:bool, frame:int) Excitation {
        let phase = cycle_position(turns - self.offset)
        var firings = self.state.firings
        var last_firing = self.state.last_firing_frame
        if phase < self.phase {
            self.heat_pa = 0.0
            if ignite {
                // Draw once per firing, with larger variations at low filling.
                let filling = 1.0 - throttle
                self.charge = 1.0 + (0.05 + 0.09 * filling) * self.fluctuation()
                self.burn_turns = self.flame_turns * (1.0 + (0.12 + 0.09 * filling) * self.fluctuation())
                self.heat_pa = (650_000.0 + 5_350_000.0 * throttle) * self.charge
                firings += 1
                last_firing = frame
            }
        }
        if self.phase < 0.43 && phase >= 0.43 && self.combustion_pa > 0.0 {
            // Empty the pressure increment over a short valve-opening front.
            // The stronger charge reaches its peak flow sooner.
            let frames = self.vent_frames / self.charge
            self.vent_pressure = self.combustion_pa * self.exhaust_scale
            self.vent_fraction = 1.0 - Math.exp(-1.0 / frames)
            self.vent_left = Math.ceil(5.0 * frames) as int
        }
        var release:float32 = 0.0
        if self.vent_left > 0 {
            if omega > 0.0 {
                self.vent_left -= 1
                release = self.vent_pressure * self.vent_fraction
                self.vent_pressure -= release
            } else {
                self.vent_left = 0
                self.vent_pressure = 0.0
            }
        }
        self.phase = phase

        let angle = round_float<float32>(phase) * 6.28318530718
        let sine = Math.sin(angle)
        let cosine = Math.cos(angle)
        let projection = Math.sqrt(self.rod_squared - self.radius_squared * sine * sine)
        let cross = self.radius_squared * sine * cosine
        let displacement = self.radius * (1.0 - cosine) + self.rod - projection
        let slope = self.radius * sine + cross / projection
        let curvature = self.radius * cosine + self.radius_squared * (cosine * cosine - sine * sine) / projection +
            cross * cross / (projection * projection * projection)
        let velocity = slope * omega

        var pressure:float32 = 101_325.0
        var flow:float32 = 0.0
        self.combustion_pa = 0.0
        if phase < 0.43 || phase >= 1.5 {
            let volume = self.clearance + self.area * displacement
            let compression = Math.pow(self.trapped_volume / volume, 1.28)
            pressure *= compression
            if phase < 0.43 {
                let burn = Math.clamp(round_float<float32>(phase) / self.burn_turns, 0.0, 1.0)
                let expansion = compression * self.expansion_scale
                self.combustion_pa = self.heat_pa * burn * burn * (3.0 - 2.0 * burn) * expansion
                pressure += self.combustion_pa
            }
        } elif phase >= 1.0 {
            let lift = Math.sin(6.28318530718 * round_float<float32>(phase - 1.0))
            flow = self.area * Math.max(0.0, velocity) * lift * (0.14 + 0.86 * throttle)
        }

        // Resolve the axial gas and inertia loads through the connecting rod.
        let axial = (pressure - 101_325.0) * self.area - self.piston_mass * curvature * omega * omega
        let side_force = axial * self.radius * sine / projection
        let friction = self.friction * (65.0 + Math.abs(side_force))
        let sliding = -friction * velocity / (0.35 + Math.abs(velocity))
        let impact = self.skirt_impact(side_force, omega > 0.0)
        self.state = CylinderState(cycle_degrees:round_float<float32>(phase * 360.0), piston_mm:displacement * 1_000.0,
            piston_mps:velocity, friction_n:friction, intake_m3_s:flow, pressure_pa:pressure,
            firings:firings, last_firing_frame:last_firing)
        return Excitation(torque_nm:axial * slope - friction * Math.abs(slope),
            sliding_n:sliding, impact_ns:impact, intake_m3_s:flow, release_pa:release)
    }

    private func fluctuation() float32 {
        self.random = (self.random * 48_271) % 2_147_483_647
        return (self.random % 16_777_216) as float32 / 8_388_608.0 - 1.0
    }

    private func skirt_impact(side_force:float32, moving:bool) float32 {
        if !moving {
            self.lateral_speed = 0.0
            return 0.0
        }
        // Inelastic contact after crossing the radial skirt clearance.
        let previous = self.lateral_position
        self.lateral_speed += side_force * self.lateral_step
        let position = previous + self.lateral_speed * (1.0 / 48_000.0)
        self.lateral_position = Math.clamp(position, -self.skirt_gap, self.skirt_gap)
        if Math.abs(position) >= self.skirt_gap {
            let impulse = self.lateral_speed * self.piston_mass
            self.lateral_speed = 0.0
            if previous != self.lateral_position { return impulse }
        }
        return 0.0
    }

    func reset() {
        self.phase = cycle_position(-self.offset)
        self.heat_pa = 0.0
        self.random = self.seed
        self.charge = 1.0
        self.burn_turns = self.flame_turns
        self.combustion_pa = 0.0
        self.vent_pressure = 0.0
        self.vent_left = 0
        self.lateral_position = 0.0
        self.lateral_speed = 0.0
        self.state = CylinderState()
        self.next(0.0, 0.0, 0.0, false, 0)
    }
}

func cycle_position(turns:float64) float64 { return turns - 2.0 * Math.floor(turns * 0.5) }
