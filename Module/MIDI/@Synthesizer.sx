use GFX.Audio.Synthesis
use GFX.Audio.Processing
use STD.Error
use STD.Math

public struct Binding {
    let channel:int
    let program:int
    var instrument:Synthesis.Instrument
}
class Channel {
    var used:bool = false
    var left:Synthesis.Control
    var right:Synthesis.Control
    init(left:Synthesis.Control, right:Synthesis.Control) { self.left = left; self.right = right }
    func update(frames:int) Result<void, Error> {
        let gain = (self.volume as float32 / 127.0) * (self.expression as float32 / 127.0)
        var left = gain; var right = gain
        if self.pan < 0.0 { right *= 1.0 + self.pan } else { left *= 1.0 - self.pan }
        try self.left.set(left, frames); try self.right.set(right, frames)
        return Result<void, Error>.success()
    }
    var program:int = 0
    var volume:int = 127
    var expression:int = 127
    var pan:float32 = 0.0
    var sustain:bool = false
    var bend:float32 = 0.0
    func reset() { self.program = 0; self.volume = 127; self.expression = 127; self.pan = 0.0; self.sustain = false; self.bend = 0.0; self.left.reset(); self.right.reset() }
}
class Note {
    var active:bool = false
    var channel:int = 0
    var number:int = 0
    var binding:int = 0
    var id:int = 0
}
// Each binding owns a distinct instrument state. Controllers belong to channels.
public class Synthesizer:Synthesis.Generator {
    let format:Processing.Format
    let note_capacity:int
    let bend_range:float32
    let gain:float32
    let controller_ramp_frames:int
    private var bindings:Binding[]
    private var channels:Channel[]
    private var notes:Note[]
    private var samples:float32[]
    private var weights:float32[]
    private let merged:bool
    private var serial:int = 0
    private init(bindings:Binding[], channels:Channel[], notes:Note[], bend_range:float32, gain:float32, controller_ramp_frames:int, merged:bool) {
        self.merged = merged
        self.bindings = bindings; self.channels = channels; self.notes = notes; self.format = bindings[0].instrument.format
        self.note_capacity = notes.count(); self.bend_range = bend_range; self.gain = gain; self.samples = []; self.weights = []; self.controller_ramp_frames = controller_ramp_frames
        var i = 0; while i < 1_024 { self.samples.append(0.0); self.weights.append(0.0); i++ }
    }
    static func create(bindings:Binding[], note_capacity:int = 256, bend_range:float32 = 2.0, gain:float32 = 0.2, controller_ramp_frames:int = 0) Result<Synthesizer, Error> {
        return Synthesizer.build(bindings, note_capacity, bend_range, gain, controller_ramp_frames, false)
    }
    package static func single(instrument:Synthesis.Instrument, note_capacity:int = 256) Result<Synthesizer, Error> {
        var bindings:Binding[] = [Binding(channel:0, program:0, instrument:instrument)]
        return Synthesizer.build(bindings, note_capacity, 2.0, 1.0, 0, true)
    }
    private static func build(bindings:Binding[], note_capacity:int, bend_range:float32, gain:float32, controller_ramp_frames:int, merged:bool) Result<Synthesizer, Error> {
        if controller_ramp_frames < 0 || controller_ramp_frames > 16_777_216 { return Result<Synthesizer, Error>.failure(invalid("MIDI controller ramp requires 0..16777216 frames")) }
        if bindings.count() < 1 || bindings.count() > 128 || note_capacity < 1 || note_capacity > 4_096 || !Math.is_finite(bend_range) || bend_range < 0.0 || bend_range > 24.0 || !Math.is_finite(gain) || gain < 0.0 || gain > 1.0 { return Result<Synthesizer, Error>.failure(invalid("MIDI synthesis requires bindings1..128, notes1..4096, bend0..24 semitones and gain0..1")) }
        let format = bindings[0].instrument.format
        if ((!merged && format.channels != 2) || format.channels < 1 || format.channels > 8) || format.sample_rate < 1 || format.sample_rate > 16_777_216 { return Result<Synthesizer, Error>.failure(invalid("MIDI synthesizer requires a supported stereo format")) }
        var i = 0
        while i < bindings.count() {
            var binding = bindings[i]
            if binding.channel < 0 || binding.channel > 15 || !data_byte(binding.program) || binding.instrument.format != format { return Result<Synthesizer, Error>.failure(invalid("MIDI bindings require channels0..15, programs0..127 and identical stereo formats")) }
            var j = 0; while j < i { if bindings[j].channel == binding.channel && bindings[j].program == binding.program { return Result<Synthesizer, Error>.failure(invalid("duplicate MIDI channel/program binding")) }
                j++ }
            i++
        }
        var channels:Channel[] = []; i = 0
        while i < 16 {
            var left = try Synthesis.Control.create(format.sample_rate, 1.0)
            var right = try Synthesis.Control.create(format.sample_rate, 1.0)
            channels.append(Channel(left, right)); i++
        }
        for binding in bindings { var state = channels[binding.channel]; state.used = true }
        var notes:Note[] = []; i = 0; while i < note_capacity { notes.append(Note()); i++ }
        return Result<Synthesizer, Error>.success(Synthesizer(bindings, channels, notes, bend_range, gain, controller_ramp_frames, merged))
    }
    private func selected(channel:int, program:int) Result<int, Error> {
        if self.merged { return Result<int, Error>.success(0) }
        var i = 0; while i < self.bindings.count() { if self.bindings[i].channel == channel && self.bindings[i].program == program { return Result<int, Error>.success(i) }
            i++ }
        return Result<int, Error>.failure(unsupported("MIDI channel/program has no application-selected instrument"))
    }
    private func broadcast(channel:int, command:Synthesis.Command) Result<void, Error> {
        for var binding in self.bindings { if binding.channel == channel { try binding.instrument.send(command) } }
        return Result<void, Error>.success()
    }
    private func release(channel:int, number:int) Result<void, Error> {
        var oldest = -1; var i = 0
        while i < self.notes.count() {
            var note = self.notes[i]
            if note.active && note.channel == channel && note.number == number && (oldest < 0 || note.id < self.notes[oldest].id) { oldest = i }
            i++
        }
        if oldest >= 0 {
            var note = self.notes[oldest]; var binding = self.bindings[note.binding]
            try binding.instrument.send(Synthesis.Command.note_off(note.id)); note.active = false
        }
        return Result<void, Error>.success()
    }
    private func release_channel(channel:int) Result<void, Error> {
        for var note in self.notes {
            if note.active && note.channel == channel { var binding = self.bindings[note.binding]; try binding.instrument.send(Synthesis.Command.note_off(note.id)); note.active = false }
        }
        return Result<void, Error>.success()
    }
    // true: translated; false: documented unsupported controller/pressure, unchanged.
    func send(channel:int, message:Message) Result<bool, Error> {
        try validate(channel, message)
        var state = self.channels[channel]
        if self.merged {
            // Per-note identities retain the original channel; channel-wide controls need explicit routing.
            match message {
                note_on(number, velocity) => {}
                note_off(number, velocity) => {}
                control_change(controller, value) => {
                    if controller == 123 { try self.release_channel(channel); return Result<bool, Error>.success(true) }
                    return Result<bool, Error>.success(false)
                }
                else => { return Result<bool, Error>.success(false) }
            }
        }
        match message {
            note_on(number, velocity) => {
                if velocity == 0 { try self.release(channel, number); return Result<bool, Error>.success(true) }
                let index = try self.selected(channel, state.program)
                var slot = -1; var i = 0; while i < self.notes.count() { if !self.notes[i].active && slot < 0 { slot = i }
            i++ }
                if slot < 0 { return Result<bool, Error>.failure(limit("MIDI held-note capacity reached")) }
                if self.serial == 9_223_372_036_854_775_807 { return Result<bool, Error>.failure(limit("MIDI note identity counter exhausted; reset")) }
                let id = self.serial + 1; let hz = try frequency(number); var binding = self.bindings[index]
                try binding.instrument.send(Synthesis.Command.note_on(id, hz, velocity as float32 / 127.0))
                var note = self.notes[slot]; note.channel = channel; note.number = number; note.binding = index; note.id = id; note.active = true; self.serial = id
            }
            note_off(number, velocity) => { try self.release(channel, number) }
            program_change(program) => { let index = try self.selected(channel, program); state.program = program }
            pitch_bend(value) => {
                let bend = (value - 8_192) as float32 / 8_192.0 * self.bend_range
                try self.broadcast(channel, Synthesis.Command.pitch_bend(bend)); state.bend = bend
            }
            control_change(controller, value) => {
                match controller {
                    7 => { state.volume = value; try state.update(self.controller_ramp_frames) }
                    11 => { state.expression = value; try state.update(self.controller_ramp_frames) }
                    10 => {
                        if value <= 64 { state.pan = (value - 64) as float32 / 64.0 }
                        else { state.pan = (value - 64) as float32 / 63.0 }
                        try state.update(self.controller_ramp_frames)
                    }
                    64 => { try self.broadcast(channel, Synthesis.Command.sustain(value >= 64)); state.sustain = value >= 64 }
                    123 => { try self.release_channel(channel) }
                    120 => {
                        for var binding in self.bindings {
                            if binding.channel == channel { binding.instrument.reset(); try binding.instrument.send(Synthesis.Command.pitch_bend(state.bend)); try binding.instrument.send(Synthesis.Command.sustain(state.sustain)) }
                        }
                        for var note in self.notes { if note.channel == channel { note.active = false } }
                    }
                    else => { return Result<bool, Error>.success(false) }
                }
            }
            else => { return Result<bool, Error>.success(false) }
        }
        return Result<bool, Error>.success(true)
    }
    func held_notes() int { var count = 0; for var note in self.notes { if note.active { count++ } }
        return count }
    func finish() Result<void, Error> {
        if self.merged {
            var instrument = self.bindings[0].instrument
            try instrument.send(Synthesis.Command.sustain(false))
            try instrument.send(Synthesis.Command.all_notes_off)
            for var note in self.notes { note.active = false }
            return Result<void, Error>.success()
        }
        var channel = 0
        while channel < 16 { try self.broadcast(channel, Synthesis.Command.sustain(false)); self.channels[channel].sustain = false; try self.broadcast(channel, Synthesis.Command.all_notes_off); channel++ }
        for var note in self.notes { note.active = false }
        return Result<void, Error>.success()
    }
    func render(samples:&float32[..]) Result<void, Error> {
        if self.merged { var instrument = self.bindings[0].instrument; return instrument.render(samples) }
        if samples.count() % 2 != 0 { return Result<void, Error>.failure(invalid("MIDI output requires complete stereo frames")) }
        var start = 0
        while start < samples.count() {
            var count = samples.count() - start; if count > 1_024 { count = 1_024 }
            var i = start; while i < start + count { samples[i] = 0.0; i++ }
            // Advance each channel once per frame, shared by all its programs.
            let frames = count / 2
            var channel = 0
            while channel < 16 {
                var state = self.channels[channel]
                if state.used {
                    try state.left.render(&self.weights[0:frames])
                    try state.right.render(&self.weights[512:512 + frames])
                    for var binding in self.bindings {
                        if binding.channel == channel {
                            try binding.instrument.render(&self.samples[0:count])
                            var frame = 0
                            while frame < frames {
                                samples[start + frame * 2] += self.samples[frame * 2] * (self.gain * self.weights[frame])
                                samples[start + frame * 2 + 1] += self.samples[frame * 2 + 1] * (self.gain * self.weights[512 + frame])
                                frame++
                            }
                        }
                    }
                }
                channel++
            }
            start += count
        }
        return Result<void, Error>.success()
    }
    func reset() {
        for var binding in self.bindings { binding.instrument.reset() }
        for var channel in self.channels { channel.reset() }
        for var note in self.notes { note.active = false }
        self.serial = 0
    }
}
