use STD.Error
use STD.Error.Kind
use STD.Process
use STD.Subprocess
use STD.Text.UTF8

// At most four FIFO requests let the worker keep producing between UI frames.
class EngineWorker {
    private var child:Subprocess.Child
    private var rpm:float = 0.0
    private var starting:bool = false
    private let driving:bool
    private let following:bool
    private let header_size:int
    private let intake_mode:bool
    private let sample_bytes:int
    private var gear:int = 0
    private var speed:float = 0.0
    private var flags:int = 0
    private var shifts:int = 0
    private var request_frames:int[4]
    private var request_head:int = 0
    private var request_count:int = 0
    private var reply:uint8[] = []

    private init(child:Subprocess.Child, key:str, driving:bool, following:bool) {
        self.following = following
        self.driving = driving; self.intake_mode = key == "cross4"
        var bytes = 2; if self.intake_mode { bytes = 4 }
        self.sample_bytes = bytes
        var size = 16; if driving { size = 32 }
        self.header_size = size
        self.child = child
    }
    static func open(root:str, profile:int = 0, key:str = "454", driving:bool = false, gearing:Gearing? = null, following:bool = false) Result<EngineWorker, Error> {
        var script = root + "/Runtime/Profile-$(key).mr"
        var impulse = root + "/Runtime/Impulse-$(key).pcm"
        if profile == 0 { script = root + "/Runtime/Profile454.mr"; impulse = root + "/Runtime/Impulse.pcm" }
        var mode = "serve"; if driving { mode = "drive" }
        if following { mode = "follow" }
        if key == "cross4" { mode += "-intake" }
        var arguments:str[] = [script, impulse, "unused", mode, "$(profile)"]
        if let value = gearing {
            arguments.append("--gearing"); arguments.append("$(value.final_drive)")
            for ratio in value.ratios { arguments.append("$(ratio)") }
        }
        var child = try Subprocess.spawn(Subprocess.SpawnCommand(
            executable:root + "/RenderReference",
            arguments:arguments,
            current_directory:root + "/Runtime", inherit_environment:true, environment:[])) else error { return Result<EngineWorker, Error>.failure(error) }
        return Result<EngineWorker, Error>.success(EngineWorker(child, key, driving, following))
    }

    func current_gear() int { return self.gear }
    func speed_kmh() float { return self.speed }
    func drive_flags() int { return self.flags }
    func shift_count() int { return self.shifts }

    func current_rpm() float { return self.rpm }
    func is_starting() bool { return self.starting }
    func has_request() bool { return self.request_count != 0 }
    func in_flight() int { return self.request_count }

    private func integer(bytes:@uint8[..], offset:int) int {
        return bytes[offset] as int + bytes[offset + 1] as int * 256 +
            bytes[offset + 2] as int * 65_536 + bytes[offset + 3] as int * 16_777_216
    }

    func request(frames:int, running:bool, pedal:bool, texture:float,
        convolution:float, base_rpm:float, load:float, mode:int = 1, gear:int = 0, braking:bool = false, operating:OperatingState? = null) Result<void, Error> {
        if frames <= 0 || frames > 960 || self.request_count == 4 {
            return Result<void, Error>.failure(Error(kind:Kind.invalid_input(), operation:"engine-reference.request",
                subject:null, detail:"1 to 960 frames and fewer than four outstanding requests required"))
        }
        var contact = 0; if running { contact = 1 }
        var acceleration = 0; if running && pedal { acceleration = 1 }
        var text = ""
        if let state = operating {
            var fuel = 0; if state.running { fuel = 1 }
            text = "$(frames) $(fuel) $(state.load) $(texture) $(convolution) $(state.rpm) 0"
        } else { text = "$(frames) $(contact) $(acceleration) $(texture) $(convolution) $(base_rpm) $(load)" }
        if self.driving {
            var brake = 0; if braking { brake = 1 }
            text += " $(mode) $(gear) $(brake)"
        }
        let command = UTF8.bytes(text + "\n")
        var sent = 0
        while sent < command.count() {
            let written = try self.child.write_standard_input(@command[sent:command.count()]) else error {
                return Result<void, Error>.failure(error)
            }
            if written <= 0 { return Result<void, Error>.failure(engine_error("engine renderer input stopped")) }
            sent += written
        }
        self.request_frames[(self.request_head + self.request_count) % 4] = frames
        self.request_count++
        return Result<void, Error>.success()
    }

    private func collect(timeout:int) Result<bool, Error> {
        if !self.has_request() { return Result<bool, Error>.success(false) }
        let expected = self.header_size + self.request_frames[self.request_head] * self.sample_bytes
        var events = 0
        while self.reply.count() < expected && events < 8 {
            let next = try self.child.next_event(timeout) else error { return Result<bool, Error>.failure(error) }
            if event = next {
                match event {
                    output(stream, data) => {
                        match stream {
                            standard_output => { for byte in data { self.reply.append(byte) } }
                            standard_error => {
                                let message = try UTF8.decode(@data[0:data.count()]) else error { panic("engine reference diagnostic is invalid UTF-8") }
                                print(message)
                            }
                        }
                    }
                    exited(status) => { return Result<bool, Error>.failure(engine_error("engine renderer exited before delivering audio")) }
                }
            } else { break }
            events++
        }
        if self.reply.count() > 4 * (self.header_size + 960 * self.sample_bytes) { panic("engine reference packet queue is too large") }
        return Result<bool, Error>.success(self.reply.count() >= expected)
    }

    private func consume(samples:&float32[..], intake:&float32[..]) {
        let frames = self.request_frames[self.request_head]
        var magic = 878_065_733; if self.driving { magic = 911_620_165 }
        if self.intake_mode { magic = 945_174_597; if self.driving { magic = 961_951_813 } }
        if self.following { magic = 1_096_169_541; if self.intake_mode { magic = 1_112_946_757 } }
        if samples.count() != frames * 2 || intake.count() != frames || self.reply.count() < self.header_size + frames * self.sample_bytes ||
            self.integer(@self.reply[0:self.reply.count()], 0) != magic ||
            self.integer(@self.reply[0:self.reply.count()], 4) != frames {
            panic("engine reference packet missing or invalid; rebuild the GFX.Audio engine library")
        }
        self.rpm = self.integer(@self.reply[0:self.reply.count()], 8) as float / 1_000.0
        self.starting = self.integer(@self.reply[0:self.reply.count()], 12) != 0
        if self.driving {
            self.gear = self.integer(@self.reply[0:self.reply.count()], 16)
            self.speed = self.integer(@self.reply[0:self.reply.count()], 20) as float / 1_000.0
            self.flags = self.integer(@self.reply[0:self.reply.count()], 24)
            self.shifts = self.integer(@self.reply[0:self.reply.count()], 28)
        }
        for frame in 0...frames {
            let offset = self.header_size + frame * self.sample_bytes
            var value = self.reply[offset] as int + self.reply[offset + 1] as int * 256
            if value >= 32_768 { value -= 65_536 }
            let sample = value as float32 / 32_768.0
            samples[frame * 2] = sample; samples[frame * 2 + 1] = sample
            intake[frame] = 0.0
            if self.intake_mode {
                let flow = self.reply[offset + 2] as int + self.reply[offset + 3] as int * 256
                intake[frame] = flow as float32 * (0.25 / 65_535.0)
            }
        }
        var remaining:uint8[] = []
        let consumed = self.header_size + frames * self.sample_bytes
        var index = consumed
        while index < self.reply.count() { remaining.append(self.reply[index]); index++ }
        self.reply = remaining
        self.request_head = (self.request_head + 1) % 4
        self.request_count--
    }

    func render_ready(samples:&float32[..], intake:&float32[..]) Result<bool, Error> {
        let ready = try self.collect(0) else error { return Result<bool, Error>.failure(error) }
        if !ready { return Result<bool, Error>.success(false) }
        self.consume(&samples[0:samples.count()], &intake[0:intake.count()])
        return Result<bool, Error>.success(true)
    }

    func render(samples:&float32[..], intake:&float32[..], running:bool, pedal:bool, texture:float,
        convolution:float, base_rpm:float, load:float, mode:int = 1, gear:int = 0, braking:bool = false, operating:OperatingState? = null) Result<void, Error> {
        if samples.count() % 2 != 0 || self.has_request() {
            return Result<void, Error>.failure(Error(kind:Kind.invalid_input(), operation:"engine-reference.render",
                subject:null, detail:"stereo frames and an empty request queue required"))
        }
        try self.request(samples.count() / 2, running, pedal, texture, convolution, base_rpm, load, mode, gear, braking, operating) else error {
            return Result<void, Error>.failure(error)
        }
        var attempts = 0
        while attempts < 100 {
            let ready = try self.collect(50) else error { return Result<void, Error>.failure(error) }
            if ready { self.consume(&samples[0:samples.count()], &intake[0:intake.count()]); return Result<void, Error>.success() }
            attempts++
        }
        return Result<void, Error>.failure(engine_error("engine renderer packet timed out"))
    }

    drop { self.child.close_standard_input() }
}
