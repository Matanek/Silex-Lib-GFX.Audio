use STD.Error
use STD.Math

public struct Gearing {
    var ratios:float64[]
    var final_drive:float64
    func validate() Result<void, Error> {
        if !gearing_value(self.final_drive) || self.ratios.count() < 1 || self.ratios.count() > 12 {
            return Result<void, Error>.failure(engine_error("gearing requires 1..12 ratios and a finite final drive in 0.05..20"))
        }
        for i, ratio in self.ratios.indexed() {
            if !gearing_value(ratio) || (i > 0 && ratio >= self.ratios[i - 1]) {
                return Result<void, Error>.failure(engine_error("gear ratios must be finite, in 0.05..20 and strictly decreasing"))
            }
        }
        return Result<void, Error>.success()
    }
}
func gearing_value(value:float64) bool { return Math.is_finite(value) && value >= 0.05 && value <= 20.0 }
