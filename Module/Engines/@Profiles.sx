public struct Profile {
    let key:str
    let label:str
    let redline:float
    let ceiling:float
    let idle:float
    let gearing:Gearing
    let gears:int
    let strokes:int
    let intake:float
    package let slot:int
    package init(key:str, label:str, redline:float, ceiling:float, idle:float, strokes:int, gears:int, gearing:Gearing, intake:float, slot:int) {
        self.key = key; self.label = label; self.redline = redline; self.ceiling = ceiling
        self.idle = idle; self.strokes = strokes; self.gears = gears; self.gearing = gearing; self.intake = intake; self.slot = slot
    }
}
