use GFX.Audio.Engines.DefaultAssets
use STD.Error
use STD.File
use STD.FileSystem
use STD.Path

// Shared by a library and every engine it creates, including reset.
class EngineFiles {
    let root:str
    private let owned:bool
    init(root:str, owned:bool = false) { self.root = root; self.owned = owned }

    static func bundled() Result<EngineFiles, Error> {
        let root = try FileSystem.create_temporary_directory() else error { return Result<EngineFiles,Error>.failure(error) }
        var files = EngineFiles(root, true)
        try DefaultAssets.populate(files) else error { return Result<EngineFiles,Error>.failure(error) }
        try FileSystem.set_executable(Path.join(root, "RenderReference"), true) else error { return Result<EngineFiles,Error>.failure(error) }
        return Result<EngineFiles,Error>.success(files)
    }
    func write(name:str, bytes:@uint8[..]) Result<void, Error> {
        let path = try Path.join(self.root, name) else error { return Result<void,Error>.failure(error) }
        if let parent = Path.parent(path) {
            try FileSystem.create_directories(parent) else error { return Result<void,Error>.failure(error) }
        }
        return try File.write_all(path, bytes)
    }
    drop { if self.owned { remove_tree(self.root) } }
}

func remove_tree(root:str) {
    match try FileSystem.list(root) {
        failure(error) => {}
        success(entries) => {
            for entry in entries {
                let path = Path.join(root, entry.name)
                match entry.kind {
                    directory => { remove_tree(path) }
                    else => { let ignored = try FileSystem.remove_file(path) }
                }
            }
        }
    }
    let ignored = try FileSystem.remove_directory(root)
}
