use GFX.Audio.Processing
use GFX.Audio.Synthesis
use STD.Math

// The native simulator supplies intake flow on the same sample clock as exhaust.
class EngineAirflow {
    private var noise:Synthesis.WhiteNoise
    private var color:Processing.Equalizer
    private var buffer:float32[] = []
    private var gain:float32 = 0.0
    private var aspiration:float32 = 0.0
    private let smoothing:float32
    private let attack:float32
    private let release:float32

    init(format:Processing.Format) {
        self.noise = Synthesis.WhiteNoise.create(format, seed:8401)
        self.color = Processing.Equalizer.create(format, low_hz:300.0, high_hz:3_000.0,
            low_gain:0.0, mid_gain:1.0, high_gain:0.15)
        let rate = format.sample_rate as float
        self.smoothing = (1.0 - Math.exp(-1.0 / (0.09 * rate))) as float32
        self.attack = (1.0 - Math.exp(-1.0 / (0.0015 * rate))) as float32
        self.release = (1.0 - Math.exp(-1.0 / (0.004 * rate))) as float32
        for _ in 0...960 { self.buffer.append(0.0) }
    }

    func mix(samples:&float32[..], intake:@float32[..], amount:float) {
        assert(samples.count() <= 960 && intake.count() * 2 == samples.count())
        let target = Math.clamp(amount, 0.0, 1.0) as float32
        if target == 0.0 && self.gain == 0.0 { self.aspiration = 0.0; return }
        self.noise.render(&self.buffer[0:samples.count()])
        self.color.process(&self.buffer[0:samples.count()])
        for frame in 0...intake.count() {
            self.gain += self.smoothing * (target - self.gain)
            if target == 0.0 && self.gain < 0.000001 { self.gain = 0.0 }
            // A fixed acoustic calibration compresses the real m3/s range. Timing
            // and throttle response come from the measured valve flow, not RPM.
            let flow = Math.sqrt(Math.clamp(intake[frame] as float * 80.0, 0.0, 1.0)) as float32
            var coefficient = self.release; if flow > self.aspiration { coefficient = self.attack }
            self.aspiration += coefficient * (flow - self.aspiration)
            if flow == 0.0 && self.aspiration < 0.000001 { self.aspiration = 0.0 }
            for channel in 0...2 {
                let i = frame * 2 + channel
                let headroom = Math.max(0.0, 0.98 - Math.abs(samples[i] as float)) as float32
                samples[i] += self.buffer[i] * 0.5 * self.gain * self.aspiration * headroom
            }
        }
    }

    func reset() { self.noise.reset(); self.color.reset(); self.gain = 0.0; self.aspiration = 0.0 }
}
