use STD.Error
use STD.Error.Kind
use STD.Text.UTF8

local func invalid(name:str) Error {
    return Error(kind:Kind.invalid_input(), operation:"audio.music.key", subject:name,
        detail:"note name requires A..G, optional # or b and an octave (C4 = 60), within MIDI 0..127")
}

