// Scientific pitch notation, parsed when describing music, before synthesis.
public func try_key(name:str) Result<int, Error> {
    let count = UTF8.byte_count(name)
    if count < 2 || count > 4 { return Result<int, Error>.failure(invalid(name)) }
    let bytes = UTF8.bytes(name)
    var letter = bytes[0] as int
    if letter >= 97 && letter <= 103 { letter -= 32 }
    var pitch = 0
    match letter {
        67 => { pitch = 0 }
        68 => { pitch = 2 }
        69 => { pitch = 4 }
        70 => { pitch = 5 }
        71 => { pitch = 7 }
        65 => { pitch = 9 }
        66 => { pitch = 11 }
        else => { return Result<int, Error>.failure(invalid(name)) }
    }
    var index = 1
    if bytes[index] == 35 { pitch++; index++ }
    else if bytes[index] == 98 { pitch--; index++ }
    if index >= count { return Result<int, Error>.failure(invalid(name)) }
    var sign = 1
    if bytes[index] == 45 { sign = -1; index++ }
    if index != count - 1 { return Result<int, Error>.failure(invalid(name)) }
    let digit = bytes[index] as int
    if digit < 48 || digit > 57 { return Result<int, Error>.failure(invalid(name)) }
    let octave = sign * (digit - 48)
    let number = (octave + 1) * 12 + pitch
    if number < 0 || number > 127 { return Result<int, Error>.failure(invalid(name)) }
    return Result<int, Error>.success(number)
}

public func try_keys(names:str[]) Result<int[], Error> {
    var numbers:int[] = []
    for name in names { numbers.append(try try_key(name)) }
    return Result<int[], Error>.success(numbers)
}

public func key(name:str) int {
    match try_key(name) {
        success(number) => { return number }
        failure(error) => { panic("$(error.detail): $(name)") }
    }
}

public func keys(names:str[]) int[] {
    match try_keys(names) {
        success(numbers) => { return numbers }
        failure(error) => {
            if let name = error.subject { panic("$(error.detail): $(name)") }
            panic(error.detail)
        }
    }
}
